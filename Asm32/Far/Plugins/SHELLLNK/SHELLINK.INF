; Shell file and folder link support FAR plugin INF file
; (c) Oscar Sacaev 1998

[Version]
Signature="$Chicago$"

[DefaultInstall]
Copyfiles=PluginFiles,HelpFiles,LangFiles,DocFiles,InfFiles
AddReg=ShellLinkerRegSection
Uninstall=RemoveShellLinker

[RemoveShellLinker]
DelFiles=PluginFiles,HelpFiles,LangFiles,DocFiles,InfFiles
DelReg=RemoveShellLinkerRegSection

[DestinationDirs]
PluginFiles=24,%PLUGINSDIR%\ShelLink
HelpFiles=24,%PLUGINSDIR%\ShelLink
LangFiles=24,%PLUGINSDIR%\ShelLink
DocFiles=24,%PLUGINSDIR%\ShelLink
InfFiles=17,

[PluginFiles]
shellink.dll

[HelpFiles]
LinkEng.hlf
LinkRus.hlf

[LangFiles]
LinkEng.lng
LinkRus.lng

[DocFiles]
ReadMe.Rus
ReadMe.Eng
History.Rus
History.Eng

[InfFiles]
shellink.inf

[SourceDisksNames]
1="ShelLinker","",1

[SourceDisksFiles]
shellink.dll=1
LinkEng.hlf=1
LinkRus.hlf=1
shellink.inf=1
LinkEng.lng=1
LinkRus.lng=1
ReadMe.Rus=1
ReadMe.Eng=1
History.Rus=1
History.Eng=1

[ShellLinkerRegSection]
HKLM,%KEY_UNINST%,"DisplayName",0,"%REMOVE_DESC%"
HKLM,%KEY_UNINST%,"UninstallString",0,"RunDll setupx.dll,InstallHinfSection RemoveShellLinker 4 %17%\shellink.inf"
HKCU,%KEY_SHLINK%,ResolveFolderLinks,3,01,00,00,00
HKCU,%KEY_SHLINK%,FolderLinkMask,2,"*.lnk"
HKCU,%KEY_SHLINK%,DescriptionPrefix,2,"Shortcut to"
HKCU,%KEY_SHLINK%,CreateOnPanel,3,01,00,00,00
HKCU,%KEY_SHLINK%,CreateOnDesktop,3,00,00,00,00

[RemoveShellLinkerRegSection]
HKCU,%KEY_SHLINK%,,,
HKLM,%KEY_UNINST%,,,

[Strings]
PLUGINSDIR=PROGRA~1\FAR\Plugins
REMOVE_DESC="FAR plugin - Shell file and folder link support" ; uninstall description
KEY_UNINST=SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\ShellLinker
KEY_SHLINK=Software\Far\Plugins\OS\ShellLinker
KEY_RENAME=Software\Microsoft\Windows\CurrentVersion\RenameFiles
