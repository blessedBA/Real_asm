// [Unknown]
// 10 Правил для случая "если предыдущий символ не рус/lat"
// первый символ - что меняем, второй - на что меняем
// крутим по кругу:
// 10 Rules for event: "if preceding symbol not russian and un-english"
// first symbol - that change, second symbol - on that change
// on cycle:
// '/' -> '.' -> '│' -> '/'
// '?' -> ',' -> 'с' -> '?'
// (по 2 символа!)
