// [russian]
// 10 Правил для случая "если предыдущий символ русский"
// первый символ - что меняем, второй - на что меняем
// (по 2 символа!)
// 10 Rules for event: "if preceding symbol - russian"
// first symbol - that change, second symbol - on that change
RulRus0=,?
RulRus1=./
RulRus2=б,
RulRus3=ю.
RulRus4=
RulRus5=
RulRus6=
RulRus7=
