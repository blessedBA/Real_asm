<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrd SYSTEM "../hrd.dtd">
<hrd>

  <assign value="2" fore="#000000" back="#ffffff" descr="default text [dText]"/>
  <assign value="3" fore="#ffffff" back="#000000" descr="current row [dRow]"/>
  <assign value="4" fore="#ffffff" back="#000000" descr="current column [dColumn]"/>
  <assign value="5" type="#1" descr="syntax check region [dSyntax]"/>

  <assign value="10" fore="#2e2e2e" descr="default number [dNumber]"/>
  <assign value="11" fore="#2e2e2e" descr="decimal number [dNumDec]"/>
  <assign value="12" fore="#2a2a2a" descr="hex number [dNumHex]"/>
  <assign value="13" fore="#1e1e1e" descr="binary number [dNumBin]"/>
  <assign value="14" fore="#2e2e2e" descr="octal number [dNumOct]"/>
  <assign value="15" fore="#2a2a2a" descr="float number [dNumFloat]"/>
  <assign value="16" fore="#222222" descr="number suffixes or prefixes [dNumSuffix]"/>

  <assign value="20" fore="#4c4c4c" descr="default string [dString]"/>
  <assign value="21" fore="#7d7d7d" descr="string in string - metastring [dString2]"/>
  <assign value="22" fore="#2a2a2a" descr="string edges [dStringQuote]"/>
  <assign value="23" fore="#a8a8a8" descr="another string edges [dStringQuote2]"/>
  <assign value="24" fore="#2a2a2a" descr="simple character [dCharacter]"/>
  <assign value="25" fore="#444444" descr="metacharacter [dCharacter2]"/>

  <assign value="30" fore="#696969" type="#1" descr="comment [dComment]"/>
  <assign value="31" fore="#868686" descr="metacomment [dComment2]"/>
  <assign value="32" fore="#444444" descr="block comment [dBlockComment]"/>
  <assign value="33" fore="#444444" descr="single line comment [dLineComment]"/>
  <assign value="34" fore="#afafaf" descr="intext documentation (extended comments) [dPod]"/>

  <assign value="40" fore="#555555" descr="symbol, operator [dSymbol]"/>
  <assign value="41" fore="#555555" descr="language base, logic symbol [dSymbol2]"/>
  <assign value="42" fore="#939393" descr="prefix [dPrefix]"/>

  <assign value="50" fore="#939393" descr="operator [dOperator]"/>

  <assign value="60" fore="#575757" descr="keyword [dKeyword]"/>
  <assign value="61" fore="#8e8e8e" descr="other keywords [dKeyword2]"/>
  <assign value="62" fore="#585858" descr="type name [dType]"/>

  <assign value="70" type="#2" descr="function - for list processing [dFunction]"/>
  <assign value="71" fore="#2a2a2a" descr="machine register [dRegister]"/>
  <assign value="72" fore="#404040" descr="constant [dConstant]"/>
  <assign value="73" fore="#454545" descr="boolean constant [dBoolean]"/>

  <assign value="80" descr="variable [dVar]"/>
  <assign value="81" fore="#3e3e3e" descr="other variable [dVar2]"/>
  <assign value="82" fore="#656565" descr="identifier [dIdentifier]"/>

  <assign value="90" fore="#2f2f2f" descr="compiler directive [dDirective]"/>
  <assign value="91" fore="#4b4b4b" descr="metadirective [dDirective2]"/>

  <assign value="100" fore="#262626" descr="parameter [dParam]"/>
  <assign value="101" fore="#676767" descr="metaparameter [dParam2]"/>

  <assign value="110" fore="#2a2a2a" descr="html-like tag [dTag]"/>
  <assign value="111" fore="#545454" descr="open tag [dOpenTag]"/>
  <assign value="112" fore="#545454" descr="close tag [dCloseTag]"/>

  <assign value="120" fore="#adadad" descr="label [dLabel]"/>
  <assign value="121" fore="#000000" back="#707070" descr="high contrast label [dInverseLabel]"/>

  <assign value="130" fore="#000000" back="#e0e0e0" descr="insertion text (code in code) [dInsert]"/>
  <assign value="131" fore="#2a2a2a" back="#e0e0e0" descr="insertion start [dInsertStart]"/>
  <assign value="132" fore="#2a2a2a" back="#e0e0e0" descr="insertion end [dInsertEnd]"/>

  <assign value="140" fore="#ffffff" back="#494949" type="#3" descr="syntax error [dError]"/>
  <assign value="141" fore="#9e9e9e" descr="possibly bad text [dErrorText]"/>
  <assign value="142" fore="#ffffff" back="#555555" type="#3" descr="todo notes [dTODO]"/>
  <assign value="143" fore="#b8b8b8" back="#515151" type="#3" descr="debug notes [dDebug]"/>

  <assign value="150" fore="#333333" descr="file path [dPath]"/>
  <assign value="151" fore="#444444" descr="URL address [dURL]"/>
  <assign value="152" fore="#676767" descr="email address [dEMail]"/>

  <assign value="160" fore="#646464" descr="date [dDate]"/>
  <assign value="161" fore="#797979" descr="time [dTime]"/>

  <assign value="170" fore="#5a5a5a" type="#100" descr="pair struct start [dpOpenStruct]"/>
  <assign value="171" fore="#5a5a5a" type="#101" descr="pair struct end [dpCloseStruct]"/>
  <assign value="172" fore="#5a5a5a" type="#100" descr="block pair start [dpOpenTag]"/>
  <assign value="173" fore="#5a5a5a" type="#101" descr="block pair end [dpCloseTag]"/>

  <assign value="180" fore="#aaaaaa" back="#000000" descr="editor selection [deSelection]"/>
  <assign value="181" fore="#7c7c7c" back="#dddddd" descr="editor border [deSelMargin]"/>
  <assign value="182" fore="#555555" back="#000000" descr="error line [deCurError]"/>
  <assign value="183" fore="#ffffff" back="#383838" descr="bookmark line [deBookmark]"/>

  <assign value="190" fore="#000000" back="#ffffff" descr="memory window [dwMemory]"/>
  <assign value="191" fore="#000000" back="#ffffff" descr="disassembly window [dwAssembly]"/>
  <assign value="192" fore="#000000" back="#ffffff" descr="watch window [dwWatch]"/>
  <assign value="193" fore="#000000" back="#ffffff" descr="calls (stack) window [dwCalls]"/>
  <assign value="194" fore="#000000" back="#ffffff" descr="values window [dwValues]"/>
  <assign value="195" fore="#000000" back="#ffffff" descr="variables window [dwVariables]"/>

</hrd>
