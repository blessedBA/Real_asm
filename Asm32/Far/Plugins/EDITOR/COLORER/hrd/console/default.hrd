  <assign value="50" fore="#00000f" descr="dOperator"/>

  <assign value="60" fore="#00000f" descr="dKeyword"/>
  <assign value="61" fore="#00000e" descr="dKeyword2"/>
  <assign value="62" fore="#00000e" descr="dType"/>

  <assign value="70" type="#2" descr="dFunction"/>
  <assign value="71" fore="#00000e" descr="dRegister"/>
  <assign value="72" fore="#00000b" descr="dConstant"/>
  <assign value="73" fore="#00000b" descr="dBoolean"/>

  <assign value="80" fore="#00000b" descr="dVar"/>
