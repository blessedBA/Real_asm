  <assign value="112" fore="#00000F" descr="dCloseTag"/>

  <assign value="120" fore="#00000d" descr="dLabel"/>
  <assign value="121" fore="#000001" back="#00000f" descr="dInverseLabel"/>

  <assign value="130" fore="#00000b" back="#000000" descr="dInsert"/>
