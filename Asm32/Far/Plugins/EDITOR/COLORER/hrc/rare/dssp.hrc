<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
   DSSP
With Help of
   Loktev Nikola <loktev@niisi.msk.ru>
-->
<hrc>

<define name="dsspString"   value="dString"/>
<define name="dsspComment"  value="dComment"/>
<define name="dsspNumber"   value="dNumber"/>
<define name="dsspWord"     value="dKeyword"/>
<define name="dsspError"    value="dError"/>
<define name="dsspExpr"     value="dDirective"/>
<define name="dsspParam"    value="dParam"/>
<define name="dsspConstr"   value="dInsert"/>

<scheme name="dsspNestComm">
  <block start="/0 \%IF/" end="/\%FI/" scheme="dsspNestComm"
         region="dsspComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>

<scheme name="Dssp">
   <!-- Linear Comments -->
   <regexp match="/^;.*$/"  region0="dsspComment"/>
   <block start="/\[/" end="/\]/" scheme="Comment"
          region="dsspComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <inherit scheme="dsspNestComm"/>
   <!-- Strings -->
   <block start='/\.??"/' end='/"/' scheme="Comment"
          region="dsspString" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <regexp match='/(\s\.*?"\r??\n??.*?\")/' region0="dsspString"/>

   <regexp match="/\c(#.)\M\s/" region0="default"/>

   <!-- Numbers -->
   <regexp match="/\b(0x|X[\da-fA-F]+)\B/" region0="dsspNumber"/>
   <regexp match="/\b([0-9]+)\B/" region0="dsspNumber"/>
   <regexp match="/\b(0x|X[\da-fA-F]@\{[^\s\W\da-fA-F]\}.@)\B/" region0="dsspError"/>

   <!-- too slow? no? you can enable/disable these regexps... -->

   <regexp match='/(\bON(\s+\S+\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'	region0="dInsert"	region2="dsspConstr"/>
   <regexp match='/(\bEON(\s+\S+\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'	region0="dInsert"	region2="dsspConstr"/>
   <regexp match='/(\bEONW(\s+\S+\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'	region0="dInsert"	region2="dsspConstr"/>
   <regexp match='/(\bDO(\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'			region0="dsspConstr" region2="dsspExpr"/>
   <regexp match='/(\bRP(\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'			region0="dsspConstr" region2="dsspExpr"/>
   <regexp match='/(\bIF0(\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'		region0="dsspConstr" region2="dsspExpr"/>
   <regexp match='/(\bIF\+(\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'		region0="dsspConstr" region2="dsspExpr"/>
   <regexp match='/(\bIF-(\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'		region0="dsspConstr" region2="dsspExpr"/>
   <regexp match='/(\bBRS(\s+[^\s\"]*(\".*?\")?[^\s\"]* \s+[^\s\"]*(\".*?\")?[^\s\"]* \s+[^\s\"]*(\".*?\")?[^\s\"]*))/x' region0="dsspWord" region2="dsspExpr"/>
   <regexp match='/(\bBR0(\s+[^\s\"]*(\".*?\")?[^\s\"]* \s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'	region0='dsspWord' region2="dsspExpr"/>
   <regexp match='/(\bBR-(\s+[^\s\"]*(\".*?\")?[^\s\"]* \s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'	region0='dsspWord' region2="dsspExpr"/>
   <regexp match='/(\bBR\+(\s+[^\s\"]*(\".*?\")?[^\s\"]* \s+[^\s\"]*(\".*?\")?[^\s\"]*))/x' region0='dsspWord' region2="dsspExpr"/>
   <regexp match='/(\bCOPYW+\s+\S+\s+\S+)/'     region0="dsspWord"/>
   <regexp match='/(\bELSE\s+[^\s\"]*(\".*?\")?[^\s\"]*)/x'  region0="dsspWord"/>
   <regexp match='/(\bBR(.*?)\sELSE(\s+[^\s\"]*(\".*?\")?[^\s\"]*))/x'	region1="dsspWord" region2="dsspExpr" region3="dsspExpr"/>
   <regexp match='/(\bSTRUCT:\s.*?\s;STRUCT)/'     region0="dsspWord"/>
   <regexp match='/(\b\S\(\s.*?\s\))/'             region0="dsspExpr"/>
   <regexp match='/(\bPROGRAM\s+\S+)/'             region0="dsspExpr"/>
   <regexp match='/(\bFORGET\s+\S+)/'              region0="dsspExpr"/>
   <regexp match="/(\bCLEAR\s+\S+)/"               region0="dsspExpr"/>
   <regexp match="/(\bGROW\s+\S+)/"                region0="dsspExpr"/>
   <regexp match="/(\bONLY\s+\S+)/"                region0="dsspExpr"/>
   <regexp match="/(\bSHUT\s+\S+)/"                region0="dsspExpr"/>
   <regexp match="/(\bCHANNEL\s+\S+)/"             region0="dsspParam"/>
   <regexp match="/(\bTRAP\s+\S+)/"                region0="dsspParam"/>
   <regexp match="/(\bVAR\s+\S+)/"                 region0="dsspParam"/>
   <regexp match="/(\bVCTR\s+\S+)/"                region0="dsspParam"/>
   <regexp match="/(\bREFVCTR\s+\S+\s+\S+\s+\S+)/" region0="dsspParam"/>
   <regexp match="/(\bARR\s+\S+)/"                 region0="dsspParam"/>
   <regexp match="/(\bSTRING\s+\S+)/"              region0="dsspParam"/>
   <regexp match="/(\bCNST\s+\S+)/"                region0="dsspParam"/>
   <regexp match="/(\bVALUE\s+\S+)/"               region0="dsspParam"/>
   <regexp match="/(\bTEXT\s+\S+)/"                region0="dsspParam"/>
   <!-- these -->

   <keywords ignorecase="ignorecase" region="dsspParam">
      <word name="ACT"/>
      <word name="ARR"/>
      <word name="B10"/>
      <word name="B16"/>
      <word name="B2"/>
      <word name="B8"/>
      <word name="BYTE"/>
      <word name="COPYW"/>
      <word name="FIX"/>
      <word name="FORGET"/>
      <word name="HEAD"/>
      <word name="LONG"/>
      <word name="PROGRAM"/>
      <word name="TRAP"/>
      <word name="UNDEF"/>
      <word name="VAR"/>
      <word name="VCTR"/>
      <word name="WORD"/>
      <word name="!"/>
      <word name="!!!"/>
      <word name="!T"/>
      <word name="!TB"/>
      <word name="@"/>
      <word name="!SB"/>
      <word name="!MB"/>
      <word name="D"/>
      <word name="DD"/>
      <word name="DDD"/>
      <word name="DDDD"/>
      <word name="E2"/>
      <word name="E2D"/>
      <word name="E3"/>
      <word name="E4"/>
      <word name="C"/>
      <word name="C2"/>
      <word name="C3"/>
      <word name="C4"/>
      <word name="SRCHB"/>
      <word name="SEG"/>
      <word name="NOP"/>
      <word name="CR"/>
      <word name="SP"/>
      <word name="SWW"/>
      <word name="SWB"/>
      <word name=">"/>
      <word name="&lt;"/>
      <word name="="/>
      <word name="&amp;"/>
      <word name="'+'"/>
      <word name="/"/>
      <word name="*"/>
      <word name="!0"/>
      <word name="!1"/>
      <word name="!1+"/>
      <word name="!1-"/>
      <word name="INTERR"/>
      <word name="RAX"/>
      <word name="RDX"/>
      <word name="RCX"/>
      <word name="TRB"/>
      <word name="TIB"/>
      <word name="TOB"/>
      <word name="TOS"/>
      <word name="LOADWIN"/>
      <word name="SAVEWIN"/>
      <word name="GENUNF"/>
      <word name="GENMENU"/>
      <word name="HS"/>
      <word name="WS"/>
      <word name="MIN"/>
      <word name="MAX"/>
      <word name="T0"/>
      <word name="T1"/>
   </keywords>
</scheme>

</hrc>
