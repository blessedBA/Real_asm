<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    Modula2 and Oberon2 Syntax (for Colorer 4ever)
With help of:
    Eugene Kotlyarov 2:5058/26.9@fidonet.org  ek@oris.ru
-->
<hrc>
<define name="ModString"   value="dString"/>
<define name="ModComment"  value="dComment"/>
<define name="ModDirective" value="dDirective2"/>
<define name="ModSymb"     value="dSymbol"/>
<define name="ModWord"     value="dKeyword"/>
<define name="ModAsm"      value="dParam"/>
<define name="ModNumb"     value="dNumber"/>

<include name="base/asm.hrc"/>

<scheme name="modula2">
   <!-- Comments -->
   <regexp match="/(&lt;\*.*?\*>)/" region0="ModDirective"/>
   <block start="/\(\*/" end="/\*\)/" scheme="Comment"
          region="ModComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/&lt;\*/" end="/\*>/" scheme="Comment"
         region="ModComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <regexp match="/(--.*$)/" region0="ModComment"/>
   <!-- paired -->
   <block start="/(\()/" end="/(\))/" scheme="modula2"
          region00="modSymb" region01="dpOpenStruct"
          region10="modSymb" region11="dpCloseStruct"/>
   <block start="/(\[)/" end="/(\])/" scheme="modula2"
          region00="modSymb" region01="dpOpenStruct"
          region10="modSymb" region11="dpCloseStruct"/>
   <block start="/\b((BEGIN)|(IF)|(LOOP)|(CASE)|(WHILE)|(FOR)|(RECORD)|(WITH)|(DEFINITION))\B/"
          end="/\b(END)\B/" scheme="modula2"
          region00="modSymb" region01="dpOpenStruct"
          region10="modSymb" region11="dpCloseStruct"/>
   <block start="/\b(REPEAT)\B/" end="/\b(UNTIL)\B/" scheme="modula2"
          region00="modSymb" region01="dpOpenStruct"
          region10="modSymb" region11="dpCloseStruct"/>

   <regexp match="/^ \s* \M (procedure)|(function) \s+ ([_\w]+)/ix" region3="dFunction"/>
   <block  start="/\b(ASM)$|\W/i" end="/^|\s(END)/i" scheme="baseasm"
           region="ModAsm" region00="ModWord" region01="dpOpenStruct"
           region10="ModWord" region11="dpCloseStruct"/>
   <!-- Strings -->
   <regexp match="/('.*?')/" region0="ModString"/>
   <regexp match='/(".*?")/' region0="ModString"/>
   <!-- CHAR  -->
   <regexp match="/\b(\d[\da-fA-F]+X)\B/" region0="ModString"/>
   <!-- Numbers  -->
   <regexp match="/\b(\d[\da-fA-F]+H)\B/" region0="ModNumb"/>
   <regexp match="/\b([0-9.]+(E|D[\-+]?\d+)?)\B/" region0="ModNumb"/>
   <!-- symbols -->
   <keywords region="ModSymb">
      <symb name="&lt;="/><symb name=">="/><symb name="^"/><symb name="+"/>
      <symb name="#"/><symb name="&amp;"/><symb name="~"/><symb name="|"/>
      <symb name="-"/><symb name="*"/><symb name="/"/><symb name=";"/>
      <symb name=":"/><symb name=":="/><symb name="="/><symb name="("/>
      <symb name="#"/><symb name=")"/><symb name="["/><symb name="]"/>
      <symb name=","/><symb name="."/><symb name=">"/><symb name="&lt;"/>
      <symb name="}"/><symb name="{"/>
   </keywords>
   <!-- Common words -->
   <keywords region="ModWord">
     <word name="ASM"/>
     <word name="ARRAY"/>
     <word name="BEGIN"/>
     <word name="BY"/>
     <word name="CASE"/>
     <word name="CONST"/>
     <word name="DEFINITION"/>
     <word name="DIV"/>
     <word name="DO"/>
     <word name="ELSE"/>
     <word name="ELSIF"/>
     <word name="END"/>
     <word name="EXIT"/>
     <word name="FOR"/>
     <word name="IF"/>
     <word name="IMPORT"/>
     <word name="IN"/>
     <word name="IS"/>
     <word name="LOOP"/>
     <word name="MOD"/>
     <word name="MODULE"/>
     <word name="OF"/>
     <word name="OR"/>
     <word name="POINTER"/>
     <word name="PROCEDURE"/>
     <word name="RECORD"/>
     <word name="REPEAT"/>
     <word name="RETURN"/>
     <word name="SET"/>
     <word name="THEN"/>
     <word name="TO"/>
     <word name="TYPE"/>
     <word name="UNTIL"/>
     <word name="VAR"/>
     <word name="WHILE"/>
     <word name="WITH"/>

     <!-- Modula2 words -->
     <word name="AND"/>
     <word name="EXCEPT"/>
     <word name="EXPORT"/>
     <word name="FINALLY"/>
     <word name="FORWARD"/>
     <word name="FROM"/>
     <word name="IMPLEMENTATION"/>
     <word name="NOT"/>
     <word name="PACKEDSET"/>
     <word name="QUALIFIED"/>
     <word name="REM"/>
     <word name="RETRY"/>

     <!-- Types -->
     <word name="SYSTEM"/>
     <word name="CARDINAL"/>
     <word name="SHORTINT"/>
     <word name="INTEGER"/>
     <word name="LONGINT"/>
     <word name="REAL"/>
     <word name="LONGREAL"/>
     <word name="WORD"/>
     <word name="BYTE"/>
     <word name="BOOLEAN"/>
     <word name="CHAR"/>
     <word name="INT8"/>
     <word name="INT16"/>
     <word name="INT32"/>
     <word name="CARD8"/>
     <word name="CARD16"/>
     <word name="CARD32"/>

     <word name="TRUE"/>
     <word name="FALSE"/>
     <word name="NIL"/>

   </keywords>
</scheme>
</hrc>