   <!-- Interbase/Firebird SQL Syntax -->
   <keywords ignorecase="ignorecase" region="ibsqlWord">
      <word name="AFTER"/>
      <word name="BEFORE"/>
      <word name="DO"/>
      <word name="GEN_ID"/>
      <word name="GENERATOR"/>
      <word name="PAGE_SIZE"/>
