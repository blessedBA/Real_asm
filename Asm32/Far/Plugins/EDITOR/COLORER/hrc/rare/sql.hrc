<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    TSQL Defines
With help of:
    Sergey <sergey@magnet.novoch.ru>
    Konstantin E. Protopopov
    Stas Mehanoshin <rampitec@tu.spb.ru>
    Akzhan Abdulin <akzhan@beep.ru>
    27 Dec 2000
    * Keywords fixed: ucommited to uncommitted, commited to committed
    + ANSI SQL92 quoted identifiers
    + Server-side cursor types (FAST_FORWARD, FORWARD_ONLY, DYNAMIC, STATIC, KEYSET, OPTIMISTIC, SCROLL_LOCKS, INSENSITIVE, READ_ONLY)
    + Missed TYPE_WARNING, SCHEMABINDING keywords
    + Locking hints highlighting
    + Microsoft SQL Server 2000
     + new FUNCTION, RETURNS keywords
     + new identity functions (SCOPE_IDENTITY, IDENT_CURRENT)
     + new data types (BIGINT, sql_variant)
     + INSTEAD OF triggers
     + FOR XML keyword
    + Interbase/Firebird Support initiated
    * Goto label highlighing fixed - no spaces allowed now. Required to unify SQL dialects (Interbase 4ex.).
    cail
    Sat 10 Feb 19:20:28 2001
    * ported into 4ever
    Vadim Lopushansky <soft@notabene.itgo.com>
-->
<hrc>

<define name="sqlQuotedIdentifier" value="dStringQuote"/>
<define name="sqlString"  value="dString"/>
<define name="sqlComment" value="dComment"/>
<define name="sqlNumb"    value="dNumber"/>
<define name="sqlWord"    value="dKeyword"/>
<define name="tsqlWord"   value="dKeyword"/>
<define name="ibsqlWord"  value="dKeyword"/>

<define name="tsqlFunc"   value="dKeyword2"/>
<define name="tsqlLockingHint" value="dKeyword2"/>
<define name="plSqlExcept" value="dConstant"/>
<define name="plSqlPackage" value="dKeyword2"/>

<include name="rare/sqlkw.hrc"/>

<scheme name="SQL">
   <!-- linear comments -->
   <regexp match="/(--.*$)/" region0="sqlComment"/>
   <regexp match="/^\s*(REM\s+).*$/i" region0="sqlComment" region1="sqlComment" /> <!-- added  -->
   <block start="/\/\*/" end="/\*\//" scheme="Comment"
          region="sqlComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <!-- strings -->
   <regexp match='/("((\\.)|[^\\"])*?")/' region0="SQLQuotedIdentifier"/>
   <regexp match="/('((\\.)|[^\\'])*?')/" region0="sqlString"/>
   <!-- Numbers -->
   <inherit scheme="mCHexNumb"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="mDecNumb"/>
   <!-- Variables -->
   <regexp match="/\@\@\w*/" region0="dVar"/>
   <regexp match="/\@\w*/" region0="dVar"/>
   <regexp match="/^\s*\w+\s* : \M [\w\s]|$/x" region0="dLabel"/>
   <regexp match="/\:\w*/" region0="dVar"/>
   <regexp match="/^\s*(&lt;&lt;)[\w_\$\@]+(>>)/" region0="dLabel" region1="dpOpenStruct" region2="dpCloseStruct"/>
   <!-- objects -->
   <regexp match="/^\M\s*(create\s+(or\s+replace\s+)?
           ((procedure)|(function)|(trigger)|(package(\s+body)?)|
            (table)|(view)|(sequence)|(constraint)|(user)|
            ((unique\s+)?index))).*$/ix"
           region0="dFunction"/>
   <!-- parencies -->
   <block start="/(\()/" end="/(\))/" scheme="SQL"
          region00="dSymbol" region01="dpOpenStruct"
          region10="dSymbol" region11="dpCloseStruct"/>
   <!-- + -->
   <!-- parencies PLSQL -->
   <block start="/\b(if)\B/i" end="/\b(end([\s])*if)\B/i" scheme="SQL"
          region00="tsqlWord" region10="tsqlWord"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(loop)\B/i" end="/\b(end([\s])*loop)\B/i" scheme="SQL"
          region00="tsqlWord" region10="tsqlWord"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(begin)\B/i" end="/\b(end)\B/ix" scheme="SQL"
          region00="tsqlWord" region10="tsqlWord"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(create(\s)*or(\s)*replace(\s)*package(.)*(\s)*is)\B/i" end="/\b(end)\B/i" scheme="SQL"
          region00="tsqlWord" region10="tsqlWord"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <!-- +. -->
   <!-- ODBC Reserved Keywords -->
   <keywords ignorecase="ignorecase" region="tsqlWord">
      <word name="ABSOLUTE"/>
      <word name="ACTION"/>
      <word name="ADA"/>
      <word name="ADD"/>
