<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    Cache/Open-M Syntax description
Made By:
    Timur Safin <timur@lanit.ru><timur@intersystems.ru>
-->

<hrc>

<include name="config/config.hrc"/>

<define name="mText"      value="dText"/>
<define name="mString"    value="dString"/>
<define name="mComment"   value="dComment"/>
<define name="mCommentEx" value="dLineComment"/>
<define name="mSymb"      value="dSymbol"/>
<define name="mWord"      value="dSymbol"/>
<define name="mPreProc"   value="dDirective"/>
<define name="mPrePrWord" value="dDirective2"/>
<define name="mTagLabel"  value="dLabel"/>

<scheme name="MPairBlock">
   <!-- paired block -->
   <!-- block start="/(\{)/" end="/(\})/" scheme="cache"
          region00="MSymb" region01="dpOpenStruct"
          region10="MSymb" region11="dpCloseStruct"/ -->
   <block start="/(\()/" end="/(\))/" scheme="cache"
          region00="MSymb" region01="dpOpenStruct"
          region10="MSymb" region11="dpCloseStruct"/>
</scheme>

<scheme name="MPrePro">
   <block  start="/\;/" end="/$/" scheme="Comment" region="MComment"/>

   <regexp match="/(&lt;[\w\d\.\-\\/]*&gt;)/" region0="MString"/>
   <regexp match='/("((\\.)|[^\\"])*?")/' region0="MString"/>

   <!-- inherit scheme="MPairBlock"/ -->
   <block start="/(\()/" end="/(\))/" scheme="MPrePro"
          region00="MSymb" region01="dpOpenStruct"
          region10="MSymb" region11="dpCloseStruct"/>


   <keywords region="MSymb">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name="("/><symb name=")"/><symb name="["/>
      <symb name="]"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name=">"/>
      <symb name="_"/><symb name="{"/><symb name="}"/><symb name="?"/>
      <symb name="#"/><symb name="@"/>
   </keywords>
   <keywords ignorecase="ignorecase" region="MPrePrWord">
      <word name="defined"/>
      <word name="sizeof"/>
      <word name="ifdef"/><word name="ifndef"/>
      <word name="define"/><word name="endif"/>
      <word name="pragma"/><word name="else"/>
      <word name="include"/><word name="if"/>
      <word name="elif"/><word name="undef"/>
      <word name="class"/>
   </keywords>
</scheme>

<scheme name="CacheCore">
    <block start="/\;/" end="/$/" scheme="Comment" region="MComment"/>
    <inherit scheme="mFloatNumb"/>
    <inherit scheme="mDecNumb"/>
    <regexp match='/("((\\.)|[^\\"])*?")/' region0="MString"/>
    <regexp match="/(\$[a-zA-Z\%][a-zA-Z\d]*)/" region0="MWord"/>
    <regexp match="/(\$\$[a-zA-Z\%][a-zA-Z\d]*)/" region0="MTagLabel"/>
    <regexp match="/(\$\$\$[a-zA-Z\%][a-zA-Z\d]*)/" region0="MPreProc"/>

    <!-- inherit scheme="MPairBlock"/ -->
    <block start="/(\()/" end="/(\))/" scheme="CacheCore"
          region00="MSymb" region01="dpOpenStruct"
          region10="MSymb" region11="dpCloseStruct"/>


    <keywords region="MSymb">
        <symb name="="/><symb name="+"/><symb name="-"/><symb name="_"/>
        <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
        <symb name="("/><symb name=")"/><symb name="?"/><symb name="["/><symb name="]"/>
        <symb name=","/><symb name="."/><symb name=":"/>
        <symb name="'"/><symb name="&lt;"/><symb name=">"/><symb name="^"/>
        <symb name="#"/><symb name="\"/><symb name="{"/><symb name="}"/>
    </keywords>

    <keywords ignorecase="ignorecase" region="MWord">
        <word name="for"/>   <word name="f"/>
        <word name="if"/>    <word name="i"/>
        <word name="while"/>
        <word name="else"/>  <word name="e"/>
        <word name="quit"/>  <word name="q"/>
        <word name="set"/>   <word name="s"/>
        <word name="do"/>    <word name="d"/>
        <word name="new"/>   <word name="n"/>
        <word name="kill"/>  <word name="k"/>
        <word name="read"/>  <word name="r"/>
        <word name="write"/> <word name="w"/>
        <word name="view"/>  <word name="v"/>
        <word name="use"/>   <word name="u"/>
        <word name="open"/>  <word name="o"/>
        <word name="close"/> <word name="c"/>
        <word name="goto"/>  <word name="g"/>
    </keywords>
</scheme>


<scheme name="cache">
    <block start="/^\s*#/" end="/$/x" scheme="MPrePro" region="MPreProc"/>
    <regexp match="/^[^\^]+\^(IN[TC])|(MAC)[^\^]*\^.*$/i" region0="dStringQuote"/>
    <block start="/^(([a-zA-Z%][\da-zA-Z%]*)|(\d\d*))/" end="/$/" region01="MTagLabel" scheme="CacheCore"/>
    <block start="/^\s/" end="/$/" scheme="CacheCore"/>
</scheme>

</hrc>
