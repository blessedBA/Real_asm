<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
   OLE extender for visual languages v1.a Syntax
With help of:
   Alexander Polosow/Ђ«ҐЄб ­¤а Џ®«®§®ў (2:5025/54.32aka2:5025/23.82)
-->
<hrc>

<define name="oleString"   value="dString"/>
<define name="oleComment"  value="dComment2"/>
<define name="oleSymb"     value="dSymbol"/>
<define name="oleWord"     value="dKeyword"/>
<define name="oleNumb"     value="dNumber"/>

<scheme name="ole">
   <!-- Linear Comments -->
   <regexp match="/(&amp;&amp;.*$)/"      region0="oleComment"/>
   <regexp match="/^(\s*\*.*$)/"  region0="oleComment"/>
   <!-- Strings -->
   <regexp match='/(\".*?\")/'    region0="oleString"/>
   <regexp match="/(\'.*?\')/"    region0="oleString"/>
   <block  start="/\{(\|.*?\|)?/" end="/\}/" scheme="ole"
           region="dInsert" region01="dString2"/>

   <!-- Numbers -->
   <regexp match="/\b(0x|X[\da-fA-F]+)\B/" region0="oleNumb"/>
   <regexp match="/\b([0-9]+)\B/" region0="oleNumb"/>

   <keywords region="oleSymb">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name="("/><symb name=")"/><symb name="["/>
      <symb name="]"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="?"/>
      <symb name="{"/><symb name="}"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="oleWord">
      <word name="Activate"/>
      <word name="ActiveDocument"/>
      <word name="Add"/>
      <word name="Application"/>
      <word name="Cells"/>
      <word name="CentimetersToPoints"/>
      <word name="Close"/>
      <word name="Documents"/>
      <word name="End"/>
      <word name="Excel"/>
      <word name="Font"/>
      <word name="InsertAfter"/>
      <word name="InsertBefore"/>
      <word name="Open"/>
      <word name="PageSetup"/>
      <word name="Paragraphs"/>
      <word name="Range"/>
      <word name="SetWidth"/>
      <word name="Size"/>
      <word name="TextColumns"/>
      <word name="Value"/>
      <word name="Word"/>
      <word name="Add"/>
      <word name="Cnt"/>
      <word name="CreateObje"/>
      <word name="CreateObject"/>
      <word name="FirstLineIndent"/>
      <word name="GetObje"/>
      <word name="GetObject"/>
      <word name="Visible"/>
      <word name="WorkBooks"/>
   </keywords>
</scheme>
</hrc>
