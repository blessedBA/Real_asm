<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
        Clipper 5.01 (.prg) Syntax Highlight v1.2 (03-Nov-2000)
        Designed for "Colorer4you" version of colorer

        This stuff needs some improvements. Send me your ideas please.
        E-mail:  webadministrator@au.ru
        FidoNet: 2:5060/9.52
        Alexey V. Yatsenko, Taganrog

        cail
        Tue 07 Nov 00:25:01 2000
          port into 4ever
-->
<hrc>

<define name="clipperText"        value="Default"/>
<define name="clipperString"      value="dString"/>
<define name="clipperComment"     value="dComment"/>
<define name="clipperSymb"        value="dSymbol"/>
<define name="clipperWord"        value="dKeyword"/>
<define name="clipperNumb"        value="dNumber"/>
<define name="clipperError"       value="dErrorText"/>
<define name="clipperOpenStruct"  value="dpOpenStruct"/>
<define name="clipperCloseStruct" value="dpCloseStruct"/>

<scheme name="clipper">
   <!-- block comments -->
   <block start="/\/\*/" end="/\*\//" scheme="Comment" region="clipperComment"
          region00="clipperOpenStruct" region10="clipperCloseStruct"/>
   <!-- linear comments -->
   <regexp match="/(&amp;&amp;.*$)/" region0="clipperComment"/>
   <regexp match="/(\/\/.*$)/"    region0="clipperComment"/>
   <regexp match="/^(\s*\*.*$)/"  region0="clipperComment"/>

   <!-- Function and procedure names -->
   <regexp match="/^\s*\M(procedure)|(function)\s+([\w_]+)/" region3="dFunction"/>

   <!-- parentheses -->
   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="clipper"/>
   </inherit>

   <!-- function-return, procedure-return -->
   <block start="/^\s*((function)|(procedure))\B/" end="/^\s*(return)\B/"
          scheme="Clipper"
          region00="clipperWord" region01="clipperOpenStruct"
          region10="clipperWord" region11="clipperCloseStruct"/>
   <!-- while-end -->
   <block start="/^\s*((do\s+)?(while))\B/" end="/\b(end(while)|(do))\B/"
          scheme="Clipper"
          region00="clipperWord" region01="clipperOpenStruct"
          region10="clipperWord" region11="clipperCloseStruct"/>
   <!-- for-next -->
   <block start="/^\s*(for)\B/" end="/\b((endfor)|(next))\B/"
          scheme="Clipper"
          region00="clipperWord" region01="clipperOpenStruct"
          region10="clipperWord" region11="clipperCloseStruct"/>
   <!-- if-endif (else and elseif not made yet) -->
   <block start="/^\s*(if)\B/" end="/\b(endif)\B/"
          scheme="Clipper"
          region00="clipperWord" region01="clipperOpenStruct"
          region10="clipperWord" region11="clipperCloseStruct"/>
   <!-- do case-endcase -->
   <block start="/^\s*(do\s+case)\B/" end="/\b(endcase)\B/"
          scheme="Clipper"
          region00="clipperWord" region01="clipperOpenStruct"
          region10="clipperWord" region11="clipperCloseStruct"/>

   <!-- strings -->
   <regexp match='/(\".*?\")/'    region0="clipperString"/>
   <regexp match="/(\'.*?\')/"    region0="clipperString"/>
   <!-- numbers -->
   <regexp match="/\b(0x|X[\da-fA-F]+)\B/" region0="clipperNumb"/>
   <regexp match="/\b([0-9]+)\B/" region0="clipperNumb"/>

   <keywords region="clipperSymb">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="?"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="clipperSymb">
      <symb name=".T."/>
      <symb name=".F."/>
      <symb name=".AND."/>
      <symb name=".OR."/>
      <symb name=".NOT."/>
   </keywords>

   <keywords ignorecase="ignorecase" region="clipperWord">
<!-- Clipper Functions -->
      <word name="AADD"/>
      <word name="ABS"/>
      <word name="ACHOICE"/>
      <word name="ACLONE"/>
      <word name="ACOPY"/>
      <word name="ADEL"/>
      <word name="ADIR"/>
      <word name="AEVAL"/>
      <word name="AFIELDS"/>
      <word name="AFILL"/>
      <word name="AINS"/>
      <word name="ALERT"/>
      <word name="ALIAS"/>
      <word name="ALLTRIM"/>
      <word name="ALTD"/>
      <word name="ARRAY"/>
