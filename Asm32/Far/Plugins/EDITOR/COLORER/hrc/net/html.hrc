    <word name="onselect"/>
    <word name="onsubmit"/>
    <word name="onunload"/>
    <word name="profile"/>
    <word name="prompt"/>
    <word name="readonly"/>
    <word name="top"/>
    <word name="rel"/>
    <word name="rev"/>
    <word name="rows"/>
    <word name="rowspan"/>
    <word name="rules"/>
    <word name="scheme"/>
    <word name="scope"/>
    <word name="scrolling"/>
    <word name="selected"/>
    <word name="shape"/>
    <word name="span"/>
    <word name="src"/>
    <word name="standby"/>
    <word name="start"/>
    <word name="summary"/>
    <word name="tabindex"/>
    <word name="target"/>
    <word name="type"/>
    <word name="url"/>
    <word name="usemap"/>
    <word name="valign"/>
    <word name="value"/>
    <word name="valuetype"/>
    <word name="visibility"/>
    <word name="version"/>
    <word name="vlink"/>
    <word name="vspace"/>
  </keywords>
  <regexp match="/ \c (0x)|\#  [\da-fA-F]+ \B /ix" region0="htmlNumb"/>
  <regexp match="/ \b [0-9\.]+%? /x" region0="htmlNumb"/>
  <block start="/(\x22|\x27)/" end="/\y1/" scheme="htmlString" region="htmlString"/>
</scheme>

<scheme name="xssi">
   <block start='/(=)\s*"/' end='/"/' scheme="perlInterpolatedString"
          region="dString" region01="dSymbol" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <keywords region="htmlParam">
     <word name="cgi"/>
     <word name="cmd"/>
     <word name="encoding"/>
     <word name="errmsg"/>
     <word name="expr"/>
     <word name="file"/>
     <word name="sizefmt"/>
     <word name="timefmt"/>
     <word name="value"/>
     <word name="var"/>
     <word name="virtual"/>
   </keywords>

   <keywords region="htmlOpenTag">
     <word name="#config"/>
     <word name="#echo"/>
     <word name="#elif"/>
     <word name="#else"/>
     <word name="#endif"/>
     <word name="#exec"/>
     <word name="#flastmod"/>
     <word name="#fsize"/>
     <word name="#if"/>
     <word name="#include"/>
     <word name="#printenv"/>
     <word name="#set"/>
   </keywords>
</scheme>

<scheme name="htmlScripts">
   <!-- scripts -->
   <block start='/ (&lt;(script [^>]+ (perlscript[\d\.]*) [^>]*) >) /ix'
          end="/(&lt;\/(script)\>)/i" scheme="Perl"
          region00="dpOpenTag" region10="dpCloseTag"
          region01="htmlTagBr" region02="htmlOpenTag" region03="htmlString"
          region11="htmlTagBr" region12="htmlCloseTag"/>
   <block start='/ (&lt;(script [^\>]+ (j(ava)?script[\d\.]*) [^\>]*) \>) /ix'
          end="/(&lt;\/(script)\>)/i" scheme="JScript"
          region00="dpOpenTag" region10="dpCloseTag"
          region01="htmlTagBr" region02="htmlOpenTag" region03="htmlString"
          region11="htmlTagBr" region12="htmlCloseTag"/>
   <block start='/ (&lt;(script [^>]+ (vbscript[\d\.]*) [^>]*) > ) /ix'
          end="/(&lt;\/(script)\>)/i" scheme="VBScript"
          region00="dpOpenTag" region10="dpCloseTag"
          region01="htmlTagBr" region02="htmlOpenTag" region03="htmlString"
          region11="htmlTagBr" region12="htmlCloseTag"/>
   <block start="/ (&lt;(script .*?) \> ) /ix" end="/(&lt;\/(script)\>)/ix" scheme="JScript"
          region00="dpOpenTag" region10="dpCloseTag"
          region01="htmlTagBr" region02="htmlOpenTag"
          region11="htmlTagBr" region12="htmlCloseTag"/>
</scheme>

<scheme name="htmlPairs">
   <block start="/(&lt; (
                 (html) | (head) | (title) |
                 (body) | (tr) | (td) | (pre) |
                 (blockquote) | (h[1-6]) | (table) |
                 ([uo]l) | ([ibu]) | (em) | (small) | (code)
                 ) &gt;)/ix" end="/(&lt;\/ (\Y2) &gt;)/ix"
          scheme="html"
          region00="dpOpenStruct" region10="dpCloseStruct"
          region01="htmlTagBr" region02="htmlOpenTag"
          region11="htmlTagBr" region12="htmlOpenTag"/>
</scheme>

<scheme name="htmlTagCall">
   <!-- this inherit let's other meta-html languages
        to disable pair searching -->
   <inherit scheme="htmlPairs"/>
   <block start="/(&lt;)\M([\w\:\-]+)/i" end="/(\/?&gt;)/" scheme="htmlCore"
          region00="dpOpenStruct" region10="dpCloseStruct"
          region01="htmlTagBr" region11="htmlTagBr"/>
   <block start="/(&lt;\/)\M([\w\:\-]+)&gt;/i" end="/(&gt;)/" scheme="htmlCore"
          region00="dpOpenStruct" region10="dpCloseStruct"
          region01="htmlTagBr" region11="htmlTagBr"
          lowpriority="lowpriority"/>
</scheme>

<scheme name="html">

   <inherit scheme="htmlScripts"/>

   <block start="/ (&lt;(style).*?>)/ix" end="/(&lt;\/(style)\>)/i" scheme="css"
          region00="dpOpenTag" region10="dpCloseTag"
          region01="htmlTagBr" region02="htmlOpenTag"
          region11="htmlTagBr" region12="htmlOpenTag"/>

   <regexp match="/ \b [0-9\.]+ /x" region0="htmlNumb"/>

   <inherit scheme="htmlTagCall"/>

   <!-- comments -->
   <block start="/&lt;!--\M#/" end="/-->/" scheme="xssi"
          region="htmlComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/&lt;!--/" end="/-->/" scheme="Comment"
          region="htmlComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/&lt;\!\M\w/" end="/>/" scheme="Comment"
          region00="dpOpenStruct" region10="dpCloseStruct" region="htmlDirective"/>

   <keywords region="htmlParam">
     <symb name=";"/>
     <symb name="="/>
     <symb name="+"/>
     <symb name="-"/>
     <symb name="/"/>
     <symb name="*"/>
     <symb name="|"/>
     <symb name="^"/>
     <symb name="("/>
