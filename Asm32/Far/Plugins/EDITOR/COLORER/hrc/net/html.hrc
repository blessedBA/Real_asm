<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    html language
    JULY <lubimovi@usa.net>
    Evgeny Stepanischev <Evgeny.Stepanischev@ksu.ru>
    Andrzej Novosiolov <andrzej@ukrnet.net>

    you can use
    <inherit scheme="htmlTagCall">
      <virtual scheme="htmlPairs" subst="empty"/>
    </inherit>
    to use safe html-tags includes in your meta-html language
-->
<hrc>

<define name="htmlString"    value="dString"/>
<define name="htmlNumb"      value="dNumber"/>
<define name="htmlComment"   value="dComment"/>
<define name="htmlDirective" value="dString"/>
<define name="htmlParam"     value="dParam"/>
<define name="htmlTagBr"     value="dTag"/>
<define name="htmlOpenTag"   value="dOpenTag"/>
<define name="htmlCloseTag"  value="dCloseTag"/>

<include name="net/css.hrc"/>
<include name="net/jscript.hrc"/>
<include name="net/vbscript.hrc"/>
<include name="base/perl.hrc"/>

<scheme name="htmlString">
</scheme>

<scheme name="htmlCoreParams">
  <keywords ignorecase="ignorecase" region="htmlParam">
    <word name="accesskey"/>
    <word name="action"/>
    <word name="class"/>
    <word name="classid"/>
    <word name="height"/>
    <word name="hidden"/>
    <word name="lang"/>
