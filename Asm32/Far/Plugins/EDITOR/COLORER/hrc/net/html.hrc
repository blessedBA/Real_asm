    <word name="frame"/>
    <word name="frameborder"/>
    <word name="framespacing"/>
    <word name="headers"/>
    <word name="href"/>
    <word name="hreflang"/>
    <word name="hspace"/>
    <word name="http-equiv"/>
    <word name="id"/>
    <word name="ismap"/>
    <word name="label"/>
    <word name="link"/>
    <word name="loop"/>
    <word name="longdesc"/>
    <word name="mailto"/>
    <word name="marginheight"/>
    <word name="marginwidth"/>
    <word name="maxlength"/>
