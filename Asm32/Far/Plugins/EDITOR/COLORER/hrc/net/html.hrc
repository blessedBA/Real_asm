<scheme name="htmlCore">
   <!--block start='/(STYLE)\s*=\s*([\x22\x27])/i' end="/(\y2)/" scheme="CSSInsideBraces"
     region="HtString" -->
  <block start="/~/" end="/~[\w\:\-]+\m/" scheme="htmlCoreTags"/>
  <inherit scheme="htmlCoreParams"/>
  <keywords ignorecase="ignorecase" region="htmlParam">
    <word name="abbr"/>
    <word name="above"/>
    <word name="accept-charset"/>
    <word name="accept"/>
    <word name="align"/>
    <word name="alink"/>
