<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    VBScript Files
With help of:
-->
<hrc>

<scheme name="vbMETA">
</scheme>

<scheme name="VBScript">
   <!-- just ignore html comments -->
   <regexp match="/^\s*&lt;!--.*$/" region0="dComment"/>
   <!-- Linear Comments-->
   <regexp match="/'|(\brem\B).*$/i" region0="dComment"/>
   <!-- Numbers -->
   <regexp match="/\b(&amp;\H|h)([\da-fA-F]+)\B/" region0="dNumber"/>
   <regexp match="/\b(&amp;\O|o)([0-7]+)\B/" region0="dNumber"/>
   <regexp match="/\b[0-9.]+(e|E[\-+]?\d+)?\B/" region0="dNumber"/>
   <!-- Strings -->
   <block start="/([\x22\x27])/" end="/\y1/" scheme="vbMETA" region="dString"/>

   <block start="/(\()/" end="/(\))/" scheme="VBScript"
          region00="dSymbol" region01="dpOpenStruct"
          region10="dSymbol" region11="dpCloseStruct"/>
   <block start="/(\[)/" end="/(\])/" scheme="VBScript"
          region00="dSymbol" region01="dpOpenStruct"
          region10="dSymbol" region11="dpCloseStruct"/>

   <keywords ignorecase="ignorecase" region="dKeyword">
         <word name="Call"/>
         <word name="Case"/>
         <word name="Dim"/>
         <word name="Do"/>
         <word name="Each"/>
         <word name="else"/>
         <word name="elseIf"/>
         <word name="End"/>
         <word name="Erase"/>
         <word name="Exit"/>
         <word name="Exit"/>
         <word name="For"/>
         <word name="Function"/>
         <word name="if"/>
         <word name="In"/>
         <word name="Loop"/>
         <word name="Next"/>
         <word name="Nothing"/>
         <word name="Preserve"/>
         <word name="Private"/>
         <word name="Public"/>
         <word name="ReDim"/>
         <word name="Select"/>
         <word name="Set"/>
         <word name="Step"/>
         <word name="Sub"/>
         <word name="then"/>
         <word name="To"/>
         <word name="Until"/>
         <word name="Wend"/>
         <word name="While"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dSymbol">
<!-- Operators Arithmetic -->
         <symb name="^"/>
         <symb name="*"/>
         <symb name="/"/>
         <symb name="\"/>
         <symb name="Mod"/>
         <symb name="+"/>
         <symb name="-"/>
         <symb name="&amp;"/>
<!-- Operators Comparison -->
         <symb name="="/>
         <symb name="&lt;>"/>
         <symb name="&lt;"/>
         <symb name="&lt;="/>
         <symb name="&gt;"/>
         <symb name=">="/>
         <word name="Is"/>
         <word name="Like"/>
<!-- Operators Logical -->
         <word name="Not"/>
         <word name="And"/>
         <word name="Or"/>
         <word name="Xor"/>
         <word name="Eqv"/>
         <word name="Imp"/>

         <symb name="~"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dConstant">
<!-- Color Constants -->
         <word name="vbBlack"/>
         <word name="vbRed"/>
         <word name="vbGreen"/>
         <word name="vbYellow"/>
         <word name="vbBlue"/>
         <word name="vbMagenta"/>
         <word name="vbCyan"/>
         <word name="vbWhite"/>

<!-- Comparison Constants -->
         <word name="vbBinaryCompare"/>
         <word name="vbTextCompare"/>
         <word name="vbDatabaseCompare"/>

<!-- Date and Time Constants -->
         <word name="vbSunday"/>
         <word name="vbMonday"/>
         <word name="vbTuesday"/>
         <word name="vbWednesday"/>
         <word name="vbThursday"/>
         <word name="vbFriday"/>
         <word name="vbSaturday"/>
         <word name="vbFirstJan1"/>
         <word name="vbFirstFourDays"/>
         <word name="vbFirstFullWeek"/>
         <word name="vbUseSystem"/>
         <word name="vbUseSystemDayOfWeek"/>

<!-- Date Format Constants -->
         <word name="vbGeneralDate"/>
         <word name="vbLongDate"/>
         <word name="vbShortDate"/>
         <word name="vbLongTime"/>
         <word name="vbShortTime"/>

<!-- File Input/Output Constants  -->
         <word name="ForReading"/>
         <word name="ForWriting"/>
         <word name="ForAppending"/>

<!-- Miscellaneous Constants -->
         <word name="vbObjectError"/>

<!-- MsgBox Constants -->
         <word name="vbOKOnly"/>
         <word name="vbOKCancel"/>
         <word name="vbAbortRetryIgnore"/>
         <word name="vbYesNoCancel"/>
         <word name="vbYesNo"/>
         <word name="vbRetryCancel"/>
         <word name="vbCritical"/>
         <word name="vbQuestion"/>
         <word name="vbExclamation"/>
         <word name="vbInformation "/>
         <word name="vbDefaultButton1"/>
         <word name="vbDefaultButton2 "/>
         <word name="vbDefaultButton3"/>
         <word name="vbDefaultButton4 "/>
         <word name="vbApplicationModal"/>
         <word name="vbSystemModal"/>

         <word name="vbOK"/>
         <word name="vbCancel"/>
         <word name="vbAbort"/>
         <word name="vbRetry"/>
         <word name="vbIgnore"/>
         <word name="vbYes"/>
         <word name="vbNo"/>

<!-- String Constants -->
         <word name="vbCr"/>
         <word name="vbCrLf"/>
         <word name="vbFormFeed"/>
         <word name="vbLf"/>
         <word name="vbNewLine"/>
         <word name="vbNullChar"/>
         <word name="vbNullString"/>
         <word name="vbTab"/>
         <word name="vbVerticalTab"/>

<!-- Tristate Constants -->
         <word name="TristateTrue"/>
         <word name="TristateFalse"/>
         <word name="TristateUseDefault"/>

<!-- VarType Constants -->
         <word name="vbEmpty"/>
         <word name="vbNull"/>
         <word name="vbInteger"/>
         <word name="vbLong"/>
         <word name="vbSingle"/>
         <word name="vbDouble"/>
         <word name="vbCurrency"/>
         <word name="vbDate"/>
         <word name="vbString"/>
         <word name="vbObject"/>
         <word name="vbError"/>
         <word name="vbBoolean"/>
         <word name="vbVariant"/>
         <word name="vbDataObject"/>
         <word name="vbDecimal"/>
         <word name="vbByte"/>
         <word name="vbArray"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dVar">
<!-- Properties -->
         <symb name=".AtEndOfLine"/>
         <symb name=".AtEndOfStream"/>
         <symb name=".Column"/>
         <symb name=".CompareMode"/>
         <symb name=".Count"/>
         <symb name=".Description"/>
         <symb name=".HelpContext"/>
         <symb name=".HelpFile"/>
         <symb name=".Item"/>
         <symb name=".Key"/>
         <symb name=".Line"/>
         <symb name=".Number"/>
         <symb name=".Source"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dKeyword">
<!-- Objects -->
         <word name="Scripting.Dictionary"/>
         <word name="Err"/>
         <word name="Scripting.FileSystemObject"/>
         <word name="TextStream"/>
         <word name="CreateTextFile"/>
         <word name="OpenTextFile"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dKeyword">
<!-- Methods -->
         <symb name=".Add"/>
         <symb name=".Clear"/>
         <symb name=".Close"/>
         <symb name=".Exists"/>
         <symb name=".Items"/>
         <symb name=".Keys"/>
         <symb name=".Raise"/>
         <symb name=".Read"/>
         <symb name=".ReadAll"/>
         <symb name=".ReadLine"/>
         <symb name=".Remove"/>
         <symb name=".RemoveAll"/>
         <symb name=".Skip"/>
         <symb name=".SkipLine"/>
         <symb name=".Write"/>
         <symb name=".WriteBlankLines"/>
         <symb name=".WriteLine"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dKeyword">
<!-- Functions -->
         <word name="Abs"/>
         <word name="Array"/>
         <word name="Asc"/>
         <word name="Atn"/>
         <word name="CBool"/>
         <word name="CByte"/>
         <word name="CCur"/>
         <word name="CDate"/>
         <word name="CDbl"/>
         <word name="Chr"/>
         <word name="CInt"/>
         <word name="CLng"/>
         <word name="Cos"/>
         <word name="CreateObject"/>
         <word name="CSng"/>
         <word name="CStr"/>
         <word name="Date"/>
         <word name="DateAddFunction"/>
         <word name="DateDiff"/>
         <word name="DatePart"/>
         <word name="DateSerial"/>
         <word name="DateValue"/>
         <word name="Day"/>
         <word name="Exp"/>
         <word name="Filter"/>
         <word name="Fix"/>
         <word name="FormatCurrency"/>
         <word name="FormatDateTime"/>
         <word name="FormatNumber"/>
         <word name="FormatPercent"/>
         <word name="GetObject"/>
         <word name="Hex"/>
         <word name="Hour"/>
         <word name="InputBox"/>
         <word name="InStr"/>
         <word name="InStrRev"/>
         <word name="Int"/>
         <word name="IsArray"/>
         <word name="IsDate"/>
         <word name="IsEmpty"/>
         <word name="IsNull"/>
         <word name="IsNumeric"/>
         <word name="IsObject"/>
         <word name="Join"/>
         <word name="LBound"/>
         <word name="LCase"/>
         <word name="Left"/>
         <word name="Len"/>
         <word name="LoadPicture"/>
         <word name="Log"/>
         <word name="LTrim"/>
         <word name="Mid"/>
         <word name="Minute"/>
         <word name="Month"/>
         <word name="MonthName"/>
         <word name="MsgBox"/>
         <word name="Now"/>
         <word name="Oct"/>
         <word name="Replace"/>
         <word name="Right"/>
         <word name="Rnd"/>
         <word name="Round"/>
         <word name="RTrim"/>
         <word name="ScriptEngine"/>
         <word name="ScriptEngineBuildVersion"/>
         <word name="ScriptEngineMajorVersion"/>
         <word name="ScriptEngineMinorVersion"/>
         <word name="Second"/>
         <word name="Sgn"/>
         <word name="Sin"/>
         <word name="Space"/>
         <word name="Split"/>
         <word name="Sqr"/>
         <word name="StrComp"/>
         <word name="StrReverse"/>
         <word name="String"/>
         <word name="Tan"/>
         <word name="Time"/>
         <word name="TimeSerial"/>
         <word name="TimeValue"/>
         <word name="Trim"/>
         <word name="TypeName"/>
         <word name="UBound"/>
         <word name="UCase"/>
         <word name="VarType"/>
         <word name="Weekday"/>
         <word name="WeekdayName"/>
         <word name="Year"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dBoolean">
<!-- other -->
         <word name="empty"/>
         <word name="true"/>
         <word name="false"/>
         <word name="null"/>
   </keywords>

</scheme>

</hrc>
