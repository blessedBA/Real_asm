      <word name="yp_get_default_domain"/>
      <word name="yp_master"/>
      <word name="yp_match"/>
      <word name="yp_order"/>
      <word name="__FILE__"/>
      <word name="__LINE__"/>
   </keywords>
   <!-- we need to include this because of dos version
        can't parse hrc files more than 25-30kb -->
   <inherit scheme="phpKwAdd"/>
</scheme>

</hrc>
