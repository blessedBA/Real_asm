<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    PHP
With Help of:
-->
<hrc>

<include name="base/c.hrc"/>
<include name="net/phpkwadd.hrc"/>

<scheme name="phpScript">
   <!-- Numbers -->
   <inherit scheme="mCHexNumb"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="mDecNumb"/>

   <!-- strings - from c.hrc -->
   <inherit scheme="cString"/>
   <inherit scheme="cSymbol"/>

   <!-- Linear Comments-->
   <regexp match="/(\/\/.*$)/" region0="dComment" lowpriority="lowpriority"/>
   <block start="/\/\*/" end="/\*\//" scheme="Comment"
          region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <regexp match="/^\M \s* function \s+ ([\w_]+) /x" region1="dFunction"/>

   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="phpScript"/>
   </inherit>

   <!-- Standard C/C++ Symbols -->
   <keywords region="dSymbol">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name="("/><symb name=")"/><symb name="["/>
      <symb name="]"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="{"/><symb name="}"/><symb name="?"/>
   </keywords>

   <!-- C/C++ KeyWords -->
   <keywords region="dKeyWord">
      <word name="break"/>
      <word name="case"/>
      <word name="class"/>
      <word name="continue"/>
      <word name="default"/>
      <word name="do"/>
      <word name="else"/>
      <word name="elseif"/>
      <word name="endif"/>
      <word name="endwhile"/>
      <word name="extends"/>
      <word name="false"/>
      <word name="for"/>
      <word name="function"/>
      <word name="global"/>
      <word name="if"/>
      <word name="include"/>
      <word name="new"/>
      <word name="require"/>
      <word name="return"/>
      <word name="switch"/>
      <word name="true"/>
      <word name="while"/>
   </keywords>

   <keywords region="dKeyWord2">
