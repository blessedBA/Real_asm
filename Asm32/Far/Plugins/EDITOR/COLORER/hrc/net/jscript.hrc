<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    JScript Files
With help of:
    Evgeny <Evgeny.Stepanischev@ksu.ru>
-->
<hrc>

<scheme name="jComment">
   <keywords region="dComment2">
     <word name="@cc_on"/>
     <word name="@cc_off"/>
     <word name="@set"/>
     <word name="@if"/>
     <word name="@_alpha"/>
     <word name="@_jscript"/>
     <word name="@_jscript_build"/>
     <word name="@_jscript_version"/>
     <word name="@_mac"/>
     <word name="@_mc680x0"/>
     <word name="@_PowerPC"/>
     <word name="@_win16"/>
     <word name="@_win32"/>
     <word name="@_x86"/>
     <word name="@_microsoft"/>
   </keywords>
</scheme>

<scheme name="jsMETA">
</scheme>

<scheme name="jsRe">
   <regexp match="/\\./" region0="dString2"/>
</scheme>

<scheme name="JScript">
   <!-- just ignore html comments -->
   <regexp match="/^\s* &lt;!-- .*$/x" region0="dComment"/>
   <regexp match="/^\s* --&gt; .*$/x" region0="dComment"/>
   <!-- Linear Comments-->
   <block start="/\/\//" end="/\M(&lt;\/scr)|$/" scheme="jComment" region="dComment"/>
   <block start="/\/\*/" end="/\*\//" scheme="jComment"
          region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <regexp match="/^\M\s* function \s+ ([\w_]+) /x" region1="dFunction"/>

   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="jscript"/>
   </inherit>

   <!-- Numbers -->
   <regexp match="/\b0x|X[\da-fA-F]+\B/" region0="dNumber"/>
   <regexp match="/\b[0-9.]+(e|E[\-+]?\d+)?\B/" region0="dNumber"/>
   <regexp match="/\b(0)([0-7]+)\B/" region0="dNumber"/>
   <!-- Strings -->
   <inherit scheme="mCString"/>
   <block start="/\x27/" end="/\x27/" scheme="jsMETA" region="dString"/>
   <regexp match='/ \/ ( (\\.) | [^\\\/] )* \/ /x' region0="dString"/>

   <regexp match="/\$[\d_*&amp;+`']/" region0="dVar"/>
   <keywords region="dKeyword">
         <word name="break"/>
         <word name="continue"/>
         <word name="else"/>
         <word name="for"/>
         <word name="function"/>
         <word name="if"/>
         <word name="in"/>
         <word name="new"/>
         <word name="return"/>
         <word name="this"/>
         <word name="typeof"/>
         <word name="var"/>
         <word name="while"/>
         <word name="with"/>
         <word name="switch"/>
         <word name="case"/>
   </keywords>
   <keywords region="dSymbol">
<!-- Properties -->
         <word name=".E"/>
         <word name=".length"/>
         <word name=".LN2"/>
         <word name=".LN10"/>
         <word name=".LOG2E"/>
         <word name=".LOG10E"/>
         <word name=".PI"/>
         <word name=".SQRT1_2"/>
         <word name=".SQRT2"/>
   </keywords>
   <keywords region="dSymbol">
<!-- Operators Computational  -->
         <symb name="++"/>
         <symb name="--"/>
         <symb name="*"/>
         <symb name="/"/>
         <symb name="%"/>
         <symb name="+"/>
         <symb name="-"/>

<!-- Operators Logical -->
         <symb name="!"/>
         <symb name="&lt;"/>
         <symb name="&gt;"/>
         <symb name="&lt;="/>
         <symb name=">="/>
         <symb name="=="/>
         <symb name="!="/>
         <symb name="&amp;&amp;"/>
         <symb name="||"/>
         <symb name="?"/>

<!-- Operators Bitwise -->
         <symb name="~"/>
         <symb name="&lt;&lt;"/>
         <symb name="/>>"/>
         <symb name=">>>"/>
         <symb name="&amp;"/>
         <symb name="^"/>
         <symb name="|"/>

<!-- Operators Assignment -->
         <symb name="==="/>
         <symb name="!=="/>
         <symb name="="/>
         <symb name="+="/>
         <symb name="-+"/>
         <symb name="*="/>
         <symb name="/="/>
         <symb name="%="/>
         <symb name="&lt;&lt;="/>
         <symb name="/>>="/>
         <symb name=">>>="/>
         <symb name="&amp;="/>
         <symb name="|="/>
         <symb name="^="/>

<!-- Operators other?  -->
         <symb name="["/>
         <symb name="]"/>
         <symb name="{"/>
         <symb name="}"/>
         <symb name="("/>
         <symb name=")"/>
         <symb name=","/>
         <symb name="."/>
         <symb name=":"/>
         <symb name=";"/>
   </keywords>

   <keywords  region="dBoolean">
         <word name="true"/>
         <word name="false"/>
         <word name="null"/>
   </keywords>

   <keywords region="dVar">
<!-- Objects -->
         <word name="arguments"/>
         <word name="caller"/>
         <word name="constructor"/>
         <word name="global"/>
         <word name="index"/>
         <word name="Infinity"/>
         <word name="input"/>
         <word name="lastIndex"/>
         <word name="MAX_VALUE"/>
         <word name="MIN_VALUE"/>
         <word name="NaN"/>
         <word name="POSITIVE_INFINITY"/>
         <word name="NEGATIVE_INFINITY"/>
         <word name="prototype"/>
         <word name="source"/>
         <word name="ignoreCase"/>
         <word name="input"/>
         <word name="lastMatch"/>
         <word name="lastParen"/>
         <word name="leftContext"/>
         <word name="multiline"/>
         <word name="rightContext"/>

         <word name="ActiveXObject"/>
         <word name="Boolean"/>
         <word name="Dictionary"/>
         <word name="Enumerator"/>
         <word name="FileSystemObject"/>
         <word name="Function"/>
         <word name="Global"/>
         <word name="Object"/>
         <word name="Number"/>
         <word name="VBArray"/>
         <word name="Array"/>
         <word name="Image"/>
         <word name="Date"/>
         <word name="Math"/>
         <word name="TextStream"/>
         <word name="RegExp"/>
   </keywords>

   <keywords region="dKeyword">
<!-- Methods -->
         <word name="abs"/>
         <word name="acos"/>
         <word name="anchor"/>
         <word name="asin"/>
         <word name="atan"/>
         <word name="atan2"/>
         <word name="AtEnd"/>
         <word name="big"/>
         <word name="blink"/>
         <word name="bold"/>
         <word name="ceil"/>
         <word name="charAt"/>
         <word name="charCodeAt"/>
         <word name="compile"/>
         <word name="concat"/>
         <word name="cos"/>
         <word name="dimensions"/>
         <word name="escape"/>
         <word name="eval"/>
         <word name="exec"/>
         <word name="exp"/>
         <word name="fixed"/>
         <word name="floor"/>
         <word name="fontcolor"/>
         <word name="fontsize"/>
         <word name="fromCharCode"/>
         <word name="getDate"/>
         <word name="getDay"/>
         <word name="getFullYear"/>
         <word name="getHours"/>
         <word name="getItem"/>
         <word name="getMilliseconds"/>
         <word name="getMinutes"/>
         <word name="getMonth"/>
         <word name="getSeconds"/>
         <word name="getTime"/>
         <word name="getTimezoneOffset"/>
         <word name="getUTCDate"/>
         <word name="getUTCDay"/>
         <word name="getUTCFullYear"/>
         <word name="getUTCHour"/>
         <word name="getUTCMilliseconds"/>
         <word name="getUTCMinutes"/>
         <word name="getUTCMonth"/>
         <word name="getUTCSeconds"/>
         <word name="getVarDate"/>
         <word name="getYear"/>
         <word name="indexOf"/>
         <word name="isFinite"/>
         <word name="isNaN"/>
         <word name="italic"/>
         <word name="item"/>
         <word name="join"/>
         <word name="lastIndexOf"/>
         <word name="lbound"/>
         <word name="link"/>
         <word name="log"/>
         <word name="match"/>
         <word name="max"/>
         <word name="min"/>
         <word name="moveFirst"/>
         <word name="moveNext"/>
         <word name="parse"/>
         <word name="parseFloat"/>
         <word name="parseInt"/>
         <word name="pow"/>
         <word name="random"/>
         <word name="replace"/>
         <word name="reserve"/>
         <word name="round"/>
         <word name="search"/>
         <word name="setDate"/>
         <word name="setFullYear"/>
         <word name="setHours"/>
         <word name="setMilliseconds"/>
         <word name="setMinutes"/>
         <word name="setMonth"/>
         <word name="setSeconds"/>
         <word name="setTime"/>
         <word name="setUTCDate"/>
         <word name="setUTCFullYear"/>
         <word name="setUTCHour"/>
         <word name="setUTCMilliseconds"/>
         <word name="setUTCMinutes"/>
         <word name="setUTCMonth"/>
         <word name="setUTCSeconds"/>
         <word name="sin"/>
         <word name="slice"/>
         <word name="small"/>
         <word name="sort"/>
         <word name="split"/>
         <word name="sqrt"/>
         <word name="strike"/>
         <word name="sub"/>
         <word name="substr"/>
         <word name="substring"/>
         <word name="sup"/>
         <word name="tan"/>
         <word name="test"/>
         <word name="toArray"/>
         <word name="toGMTString"/>
         <word name="toLocaleString"/>
         <word name="toLowerCase"/>
         <word name="toString"/>
         <word name="toUpperCase"/>
         <word name="toUTCString"/>
         <word name="ubound"/>
         <word name="unescape"/>
         <word name="UTC"/>
         <word name="valueOf"/>
   </keywords>

</scheme>

</hrc>
