<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    resources
With help of:
    Alexander Voronenko <Alexander.Voronenko@p47.f100.n452.z2.fidonet.org>
-->

<hrc>

<include name="base/c.hrc"/>

<scheme name="Resource">
   <!-- C Preprocessor -->
   <block  start="/^\s*#/" end="/^|( [^\\]?#1 )$/x" scheme="CPrePro" region="CPreProc"/>
   <!-- Numbers -->
   <inherit scheme="mCHexNumb"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="mDecNumb"/>
   <!-- strings -->
   <regexp match='/[Ll]?"((\\.)|[^\\"])*?"/' region0="dString"/>
   <regexp match="/[Ll]?'..??.??.??'/" region0="dString"/>

   <!-- Linear Comments-->
   <regexp match="/\/\/.*$/" region0="dComment"/>
   <block start="/\/\*/" end="/\*\//" scheme="Comment"
          region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <keywords region="dsymbol">
      <symb name="-"/><symb name="="/><symb name="+"/>
      <symb name=","/><symb name="."/><symb name="_"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dDirective">
      <word name="BEGIN"/>
      <word name="END"/>
      <word name="LOADONCALL"/>
      <word name="MOVEABLE"/>
      <word name="DISCARDABLE"/>
      <word name="PURE"/>
      <word name="OWNERDRAW"/>
      <word name="NOT"/>
      <word name="NONSHARED"/>
      <word name="PRELOAD"/>
      <word name="MENUBREAK"/>
      <word name="MENUBARBREAK"/>
      <word name="SEPARATOR"/>
      <word name="IMPURE"/>
      <word name="FIXED"/>
      <word name="GRAYED"/>
      <word name="CHECKED"/>
      <word name="BLOCK"/>
      <word name="HELP"/>
      <word name="INACTIVE"/>
      <word name="SEGALIGN"/>
      <word name="NONDISCARDABLE"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="dKeyWord">
      <word name="ASCII"/>
      <word name="POPUP"/>
      <word name="MENUITEM"/>
      <word name="SHIFT"/>
      <word name="CONTROL"/>
      <word name="NOINVERT"/>
      <word name="ALT"/>
      <word name="BITMAP"/>
      <word name="MENU"/>
      <word name="ACCELERATOR"/>
      <word name="CURSOR"/>
      <word name="ICON"/>
      <word name="CAPTION"/>
      <word name="VERSIONINFO"/>
      <word name="VALUE"/>
      <word name="DIALOGEX"/>
      <word name="STYLE"/>
      <word name="DIALOG"/>
      <word name="PUSHBUTTON"/>
      <word name="FONT"/>
      <word name="EXSTYLE"/>
      <word name="EDITTEXT"/>

      <word name="VIRTKEY"/>
      <word name="VERSION"/>
      <word name="USERBUTTON"/>
      <word name="STATIC"/>
      <word name="STATE3"/>
      <word name="SHARED"/>
      <word name="SCROLLBAR"/>
      <word name="RTEXT"/>
      <word name="RCDATA"/>
      <word name="RADIOBUTTON"/>
      <word name="PUSHBOX"/>
      <word name="PRODUCTVERSION"/>
      <word name="MESAGETABLE"/>
      <word name="LTEXT"/>
      <word name="LISTBOX"/>
      <word name="LANGUAGE"/>
      <word name="IEDIT"/>
      <word name="HEDIT"/>
      <word name="GROUPBOX"/>
      <word name="FILEVERSION"/>
      <word name="FILETYPE"/>
      <word name="FILESUBTYPE"/>
      <word name="FILEOS"/>
      <word name="FILEFLAGSMASK"/>
      <word name="FILEFLAGS"/>
      <word name="EDIT"/>
      <word name="DLGINIT"/>
      <word name="DLGINCLUDE"/>
      <word name="DEFPUSHBUTTON"/>
      <word name="CTEXT"/>
      <word name="TEXTINCLUDE"/>
      <word name="COMBOBOX"/>
      <word name="CLASS"/>
      <word name="CHECKBOX"/>
      <word name="CHARACTERISTICS"/>
      <word name="BUTTON"/>
      <word name="BEDIT"/>
      <word name="AUTORADIOBUTTON"/>
      <word name="AUTOCHECKBOX"/>
      <word name="AUTO3STATE"/>
      <word name="HTML"/>
      <word name="ANI"/>
      <word name="ANICURSOR"/>
      <word name="VXD"/>
      <word name="PLUGPLAY"/>
      <word name="GROUP_ICON"/>
      <word name="GROUP_CURSOR"/>
      <word name="MESSAGETABLE"/>
      <word name="FONTDIR "/>
      <word name="STRING"/>
      <word name="TOOLBAR"/>
      <word name="MENUEX"/>
      <word name="ACCELERATORS"/>
      <word name="STRINGTABLE"/>
   </keywords>

</scheme>
</hrc>