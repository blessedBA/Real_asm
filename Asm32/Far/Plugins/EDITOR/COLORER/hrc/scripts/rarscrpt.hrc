<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
   RAR install script
With help of:
   Morris/Elysium <morris@elysium.pl>
-->

<hrc>

<define name="rString"    value="dString"/>
<define name="rComment"   value="dComment"/>
<define name="rSymb"      value="dSymbol"/>
<define name="rCmd"       value="dKeyword"/>
<define name="rScreenCmd" value="dParam"/>
<define name="rIOCmd"     value="dKeyword"/>
<define name="rProc"      value="dKeyword"/>
<define name="rVar"       value="dVar"/>
<define name="rNumb"      value="dNumber"/>
<define name="rLabel"     value="dLabel"/>
<define name="rConst"     value="dVar"/>

<scheme name="rarscript">
   <!-- Comments -->
   <regexp match="/(;.*$)/" region0="rComment"/>
   <!-- Numbers  -->
   <inherit scheme="mDecNumb"/>
   <!-- Strings -->
   <block start="/(^\s*outtext\s+(ansi )?\s*on)/i" end="/(^\s*outtext\s+(ansi )?\s*off)/i"
          scheme="Comment" region="rString" region01="rScreenCmd" region11="rScreenCmd"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
   <regexp match='/(\".*?\")/' region0="rString"/>
   <!-- Labels -->
   <regexp match="/(\S+)(:)/" region1="rLabel" region2="rSymb"/>

   <keywords region="rSymb">
      <symb name="&lt;="/><symb name=">="/><symb name="&gt;"/><symb name="&lt;"/>
      <symb name="!="/><symb name="=="/>
      <symb name="+"/><symb name="%"/><symb name="-"/><symb name="*"/>
      <symb name="/"/><symb name="="/>
      <symb name="("/><symb name=")"/><symb name=","/>
   </keywords>

   <keywords  region="rCmd">
     <word name="CALL"/>
     <word name="DELAY"/>
     <word name="EXCLUDE"/>
     <word name="EXIT"/>
     <word name="GOTO"/>
     <word name="IF"/>
     <word name="ENDIF"/>
     <word name="IFEXIST"/>
     <word name="INCLUDE"/>
     <word name="INSTALL"/>
     <word name="OVERWRITE"/>
     <word name="PROC"/>
     <word name="ENDP"/>
     <word name="SOUND"/>
     <word name="SYSTEM"/>
   </keywords>

   <keywords  region="rScreenCmd">
     <word name="BOX"/>
     <word name="CLRSCR"/>
     <word name="CTEXT"/>
     <word name="GOTOXY"/>
     <word name="DEFBAR"/>
     <word name="MESSAGE"/>

     <word name="RESTSCR"/>
     <word name="SAVESCR"/>
     <word name="SETCOLOR"/>
     <word name="TEXT"/>
     <word name="WINDOW"/>
   </keywords>

   <keywords  region="rIOCmd">
     <word name="EXEC"/>
     <word name="GETDFREE"/>
     <word name="GETKEY"/>
     <word name="INPUT"/>
     <word name="MENU"/>
   </keywords>

   <keywords  region="rProc">
     <word name="ArcDone"/>
     <word name="ChangeVol"/>
     <word name="Error"/>
     <word name="FileDone"/>
     <word name="OnKey"/>
   </keywords>

   <keywords  region="rVar">
     <word name="ArcName"/>
     <word name="AVPresent"/>
     <word name="AVArcName"/>
     <word name="AVDate"/>
     <word name="AVUserName"/>
     <word name="FileName"/>
     <word name="DestFileName"/>
     <word name="DestDir"/>
     <word name="Password"/>

     <word name="Par1"/>
     <word name="Par2"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="rConst">
     <word name="ON"/>
     <word name="OFF"/>
     <word name="FRESH"/>
     <word name="UPDATE"/>

     <word name="BLACK"/>
     <word name="BLUE"/>
     <word name="GREEN"/>
     <word name="CYAN"/>
     <word name="RED"/>
     <word name="MAGENTA"/>
     <word name="BROWN"/>
     <word name="LIGHTGRAY"/>
     <word name="DARKGRAY"/>
     <word name="LIGHTBLUE"/>
     <word name="LIGHTGREEN"/>
     <word name="LIGHTCYAN"/>
     <word name="LIGHTRED"/>
     <word name="LIGHTMAGENTA"/>
     <word name="YELLOW"/>
     <word name="WHITE"/>

     <word name="SINGLE"/>
     <word name="DOUBLE"/>
   </keywords>
</scheme>

</hrc>