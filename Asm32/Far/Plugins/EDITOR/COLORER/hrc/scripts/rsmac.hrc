     <word name="NDays30"/>
     <word name="OBMoveAccount"/>
     <word name="OBRunBackout"/>
     <word name="OBRunCarry"/>
     <word name="PassivA"/>
     <word name="PassivAC"/>
     <word name="PassivB"/>
     <word name="PassivBC"/>
     <word name="PercPostDoc"/>
     <word name="PeriodTotals"/>
     <word name="prevdate"/>
     <word name="PrintDeal"/>
     <word name="RatePeriodAlg"/>
     <word name="RegPairedAccounts"/>
     <word name="RegPairedAccountsC"/>
     <word name="RestA"/>
     <word name="RestAC"/>
     <word name="RestB"/>
     <word name="RestBC"/>
     <word name="RubToStrAlt"/>
     <word name="RunBackout"/>
     <word name="RunCarry"/>
     <word name="RunVisual"/>
     <word name="SeansInter"/>
     <word name="SendToKvit"/>
     <word name="SetApplicationKey"/>
     <word name="ShowDealParametrs"/>
     <word name="SizeSum"/>
     <word name="SplitRecalc"/>
     <word name="SumSymbC"/>
     <word name="ViewPercDoc"/>
     <word name="Workdays"/>
     <word name="WorkDeal"/>
     <word name="WorkExtDeal"/>
   </keywords>
</scheme>

<scheme name="RSCore">
   <regexp match="/\c([\x24]?[\d\.]+)\B/" region0="dNumber"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="CNestComm"/>
   <inherit scheme="mCString"/>
   <block start="/\[/" end="/\]/" scheme="StringInBrackets"
          region="dString" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/\{/" end="/\}/" scheme="RSSpecVars" region="dDirective2"
          region00="dpOpenStruct" region10="dpCloseStruct"/>

   <inherit scheme="RSKeywords"/>

   <keywords ignorecase="ignorecase" region="dSymbol">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name="$"/>
      <symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="?"/>
   </keywords>
   <keywords ignorecase="ignorecase" region="dKeyword">
     <word name="elif"/>
     <word name="else"/>
     <word name="end"/>
   </keywords>
   <keywords ignorecase="ignorecase" region="dKeyword2">
     <word name="ExecExp"/>
     <word name="execmacro"/>
     <word name="execmacro2"/>
     <word name="ExecMacroFile"/>
     <word name="ExistFile"/>
     <word name="Exit"/>
     <word name="Exp"/>
   </keywords>
</scheme>

<scheme name="RSBrackets">
   <inherit scheme="RSCore"/>
   <block start="/(\()/" end="/(\))/" scheme="RSBrackets"
          region00="dSymbol" region01="dpOpenStruct"
          region10="dSymbol" region11="dpCloseStruct"/>
</scheme>

<scheme name="RSBlockStruct">
   <block start="/\b((if)|(while)|(with))\B/i" end="/\b(end)\B/i"
          scheme="RSBlockStruct"
          region00="dKeyword" region10="dKeyword"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <inherit scheme="RSBrackets"/>
</scheme>

<scheme name="RSMac">
   <regexp match="/\b((file)|(record))\s+([^ \t\(]+)\s*((\()(.*?)(,(.*?))?(\)))?/i"
           region1="dKeyword" region4="dVar" region5="dSymbol" region7="dString"
           region9="dString"/>
   <block start="/\b((((macro)|(class))))\B/i" end="/\b(end)\B/i" scheme="RSMac"
          region01="dKeyword" region10="dKeyword"
          region02="dpOpenStruct" region00="dFunction" region11="dpCloseStruct"/>
   <inherit scheme="RSBlockStruct"/>
</scheme>

</hrc>