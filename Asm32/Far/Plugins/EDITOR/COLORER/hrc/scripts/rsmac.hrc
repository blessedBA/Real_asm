<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
   R-Style MACros Syntax description
With help of:
   TSW (Nikolas Tuzhilin) <tsw@glasnet.ru>
   Andrzej Novosiolov <anovos@rs-ukraine.kiev.ua>
-->

<hrc>

<scheme name="StringInBrackets">
   <!-- [...###...]  -->
   <keywords region="dSymbol">
      <symb name="#"/>
   </keywords>
</scheme>

<scheme name="FileDeclaration">
   <!-- FILE aaa (bbb) parameters... -->
   <!-- Numbers -->
   <regexp match="/\b(\d+)\B/" region0="dNumber"/>
   <!-- Strings -->
   <regexp match='/(\(\"?.*\"?\))/' region0="dString"/>
   <!-- Linear Comments-->
   <block start="/\/\*/" end="/\*\//" scheme="Comment"
          region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <!-- Symbols -->
   <keywords region="dSymbol">
      <symb name=";"/><symb name="-"/>
   </keywords>
</scheme>

<scheme name="RSSpecVars">
   <keywords ignorecase="ignorecase" region="dDirective">
     <word name="BASECASH"/>
     <word name="BatchMode"/>
     <word name="CALCRATE"/>
     <word name="CASHDEP"/>
     <word name="CORAC_Bank"/>
     <word name="curdate"/>
     <word name="DEBETRATE"/>
