     <word name="FIO_Boss"/>
     <word name="KREDITRATE"/>
     <word name="IOBAccount"/>
     <word name="KU_Bank"/>
     <word name="KU_RCC"/>
     <word name="MFO_Bank"/>
     <word name="MFO_RCC"/>
     <word name="Name_Bank"/>
     <word name="Name_Boss"/>
     <word name="NumDprt"/>
     <word name="OBalance_Index1"/>
     <word name="OBalance_Index2"/>
     <word name="OBalance_Index3"/>
     <word name="OBalance_IndexU"/>
     <word name="OBalance_Sys"/>
     <word name="oper"/>
     <word name="Post_Addr"/>
     <word name="TRANDEP"/>
   </keywords>
</scheme>

