<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    vim scripts
-->

<hrc>

<scheme name="vim">
   <inherit scheme="mDecNumb"/>
   <regexp match='/^\s*\".*$/' region0="dComment"/>
   <regexp match='/\\"/' region0="dString"/>
   <regexp match='/\".*?\"/' region0="dString"/>
   <regexp match='/\s?#1(\".*)$/' region1="dComment"/>
   <regexp match='/\$\w*/' region0="dVar"/>
   <regexp match='/\:\w*/' region0="dKeyword"/>

   <keywords ignorecase="ignorecase" region="dKeyword">
      <symb name="{"/><symb name="}"/>
      <symb name="("/><symb name=")"/>
      <symb name="="/>
      <word name="syn"/>
      <word name="keyword"/>
      <word name="contained"/>
      <word name="match"/>
      <word name="hi"/>
      <word name="let"/>
      <word name="au"/>
   </keywords>
   <keywords ignorecase="ignorecase" region="dDirective">
      <word name="if"/>
      <word name="endif"/>
      <word name="else"/>
   </keywords>
</scheme>

</hrc>