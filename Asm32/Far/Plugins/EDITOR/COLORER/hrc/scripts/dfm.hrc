<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    DFM Syntax
With help of:
    Kreevosheyev Vitaly (aka Shatl)  <shatl@nasnet.kiev.ua>
-->

<hrc>

<define name="dfmHexData"   value="dParam"/>

<scheme name="delphiform">
  <!-- Strings -->
  <block start="/\{/" end="/\}/" scheme="Comment"
         region="dfmHexData" region00="dpOpenStruct" region10="dpCloseStruct"/>
  <regexp match="/(\'.*')/" region0="dString"/>
  <inherit scheme="mDecNumb"/>

  <keywords region="dSymbol">
    <symb name="="/> <symb name=":"/> <symb name="&lt;"/> <symb name="&gt;"/>
    <symb name="["/> <symb name="]"/> <symb name="{"/> <symb name="}"/>
    <symb name="-"/>
  </keywords>

  <keywords ignorecase="ignorecase" region="dKeyword">
    <word name="OBJECT"/>
    <word name="END"/>
  </keywords>
</scheme>

</hrc>