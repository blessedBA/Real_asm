<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
   FoxPro Extended v1.1 Syntax
With help of:
   Alexander Polosow/Ђ«ҐЄб ­¤а Џ®«®§®ў (2:5025/54.32aka2:5025/23.82)
   build with 'FoxPro Syntax' by
   Cyrill Panov/ЉЁаЁ«« Џ ­®ў <Cyrill.Panov@usu.ru>
-->
<hrc>

<define name="foxString"   value="dString"/>
<define name="foxComment"  value="dComment"/>
<define name="foxSymb"     value="dSymbol"/>
<define name="foxWord"     value="dKeyword"/>
<define name="foxNumb"     value="dNumber"/>

<include name="rare/olextend.hrc"/>

<scheme name="foxpro">
   <!-- Linear Comments -->
   <regexp match="/&amp;&amp;.*$/"      region0="foxComment"/>
   <regexp match="/\/\/.*$/"    region0="foxComment"/>
   <regexp match="/^\s*\*.*$/"  region0="foxComment"/>
   <!-- Strings -->
   <regexp match='/\".*?\"/'    region0="foxString"/>
   <regexp match="/\'.*?\'/"    region0="foxString"/>
   <block  start="/(\{)(\|.*?\|)?/" end="/(\})/" scheme="foxpro"
           region="dInsert" region00="foxSymb" region02="foxString" region10="foxSymb"
           region01="dpOpenStruct" region11="dpCloseStruct"/>

   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="foxpro"/>
   </inherit>

   <regexp match="/^\s* \M (procedure)|(function) \s+ ([_\w]+)/ix" region3="dFunction"/>

   <!-- Numbers -->
   <regexp match="/\b0x|X[\da-fA-F]+\B/" region0="foxNumb"/>
   <regexp match="/\b[0-9]+\B/" region0="foxNumb"/>

   <inherit scheme="ole"/>

   <keywords region="foxSymb">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name="("/><symb name=")"/><symb name="["/>
      <symb name="]"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="?"/>
      <symb name="{"/><symb name="}"/>
   </keywords>

   <keywords ignorecase="ignorecase" region="foxWord">
      <symb name=".T."/>
      <symb name=".F."/>
      <word name="AND"/>
      <symb name=".AND."/>
      <word name="OR"/>
      <symb name=".OR."/>
      <word name="NOT"/>
      <symb name=".NOT."/>
   </keywords>

   <keywords ignorecase="ignorecase" region="foxWord">
      <word name="@"/>
      <word name="_MSYSMENU"/>
      <word name="_SCREEN"/>
      <word name="ABS"/>
      <word name="ACCEPT"/>
      <word name="ACTI"/>
      <word name="ACTIVATE"/>
      <word name="AGAIN"/>
      <word name="ALIAS"/>
      <word name="ALL"/>
      <word name="ALLTRIM"/>
      <word name="ALTERNATE"/>
      <word name="ANSI"/>
      <word name="ANSITOOEM"/>
      <word name="APLABOUT"/>
      <word name="APPE"/>
      <word name="APPEND"/>
      <word name="ARRAY"/>
      <word name="ASC"/>
      <word name="AT"/>
      <word name="ATAN"/>
      <word name="ATLINE"/>
      <word name="AUTOSAVE"/>
      <word name="BACKCOLOR"/>
      <word name="BAR"/>
