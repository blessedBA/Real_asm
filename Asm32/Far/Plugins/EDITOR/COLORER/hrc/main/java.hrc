</scheme>

<scheme name="DocumentationComment">
   <inherit scheme="htmlTagCall">
     <virtual scheme="htmlPairs" subst="empty"/>
   </inherit>

   <inherit scheme="mNetAddresses"/>
   <keywords region="dComment2">
      <symb name="*"/>
      <symb name=","/><symb name="."/><symb name=":"/><symb name=";"/>
      <symb name="+"/><symb name="-"/><symb name="/"/>
   </keywords>
   <regexp match="/ \b ([0-9\.]+) \B /x" region0="dNumber"/>
   <regexp match="/(\@author)\s+(\S.*)/x" region1="dComment2" region2="dComment2"/>
   <!--regexp match="/(\@)(\w+)/" region1="dSymbol"-->
   <keywords region="dComment2">
      <word name="@beaninfo"/>
      <word name="@deprecated"/>
      <word name="@exception"/>
      <word name="@param"/>
      <word name="@return"/>
      <word name="@see"/>
      <word name="@seealso"/>
      <word name="@serial"/>
      <word name="@since"/>
      <word name="@modified"/>
      <word name="@throws"/>
      <word name="@version"/>
      <symb name="@(#)"/>
      <symb name="#"/>
      <symb name="@"/>
   </keywords>
</scheme>

</hrc>
