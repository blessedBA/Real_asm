<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    Java Files
With help of:
    JULY <lubimovi@usa.net>
-->
<hrc>

<include name="net/html.hrc"/>
<include name="base/c.hrc"/>

<scheme name="Java">
   <!-- Linear Comments-->
   <block start="/\/\//" end="/$/" scheme="Comment" region="dComment"/>
   <block start="/\/\*\*/" end="/\*\//" scheme="DocumentationComment"
          region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/\/\*/" end="/\*\//" scheme="Comment"
          region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <regexp match='/\M \b( (struct)|(class) \s+ ([\w_]+ [\w_:\s]*? [^;]) )$/x'
           region4="dFunction"/>

   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="java"/>
   </inherit>

   <!-- numbers -->
   <inherit scheme="mCHexNumb"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="mDecNumb"/>
   <!-- strings -->
   <block start='/"/' end='/"|$/' scheme="cStringCore" region="cString"/>
   <inherit scheme="cSymbol"/>

   <!-- Standard Symbols -->
   <keywords region="dError">
      <symb name="["/><symb name="]"/>
      <symb name="{"/><symb name="}"/>
      <symb name="("/><symb name=")"/>
      <symb name="*/"/>
   </keywords>
   <keywords region="dSymbol">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="?"/>
   </keywords>
   <keywords region="dKeyword">
      <word name="abstract"/>
      <word name="break"/>
      <word name="byte"/>
      <word name="boolean"/>
      <word name="catch"/>
      <word name="case"/>
      <word name="class"/>
      <word name="char"/>
      <word name="continue"/>
      <word name="default"/>
      <word name="double"/>
      <word name="do"/>
      <word name="else"/>
      <word name="extends"/>
      <word name="false"/>
      <word name="final"/>
      <word name="float"/>
      <word name="for"/>
      <word name="finally"/>
      <word name="if"/>
      <word name="import"/>
      <word name="implements"/>
      <word name="int"/>
      <word name="interface"/>
      <word name="instanceof"/>
      <word name="long"/>
      <word name="length"/>
      <word name="native"/>
      <word name="new"/>
      <word name="null"/>
      <word name="package"/>
      <word name="private"/>
      <word name="protected"/>
      <word name="public"/>
      <word name="return"/>
      <word name="switch"/>
      <word name="synchronized"/>
      <word name="short"/>
      <word name="static"/>
      <word name="super"/>
      <word name="try"/>
      <word name="true"/>
      <word name="this"/>
      <word name="throw"/>
      <word name="throws"/>
      <word name="threadsafe"/>
      <word name="transient"/>
      <word name="void"/>
      <word name="while"/>
   </keywords>
   <keywords region="dKeyword2">
