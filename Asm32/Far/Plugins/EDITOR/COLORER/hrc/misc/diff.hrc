<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    Colorer description for Diff/Patch files
With Help of
    Timur Safin <timur@lanit.ru>
-->
<hrc>

<define name="diffCmdLine"   value="dDirective"/>
<define name="diffSngLine"   value="dParam"/>
<define name="diffOrg"       value="dString2"/>
<define name="diffFiles"     value="dVar2"/>
<define name="diffNew"       value="dString"/>
<define name="diffChanged"   value="dKeyword"/>
<define name="diffNumb"      value="dNumber"/>
<define name="diffModif"     value="dLabel"/>

<scheme name="diff">
   <!-- Command line -->
   <regexp match="/^diff\s+\-.*$/" region0="diffCmdLine"/>
   <regexp match="/^Only\s+.*$/" region0="diffSngLine"/>
   <regexp match="/^Index.*$/" region0="diffSngLine"/>
   <!-- context mode -->
   <regexp match="/^\-\-\-\s.+$/" region0="diffFiles"/>
   <regexp match="/^\+\+\+\s.+$/" region0="diffFiles"/>
   <regexp match="/^\*\*\*\*\*\*\*.*/" region0="diffOrg"/>
   <regexp match="/^\*.*$/" region0="diffOrg"/>
   <regexp match="/^\+.*$/" region0="diffNew"/>

   <regexp match="/^!.*$/" region0="diffChanged"/>

   <!-- default mode -->
   <regexp match="/^&lt;\s.*$/" region0="diffOrg"/>
   <regexp match="/^&gt;\s.*$/" region0="diffNew"/>
   <regexp match="/^\d+(\,\d+)?[acd]\d+(,\d+)?$/" region0="diffModif"/>

   <!-- unified mode -->
   <regexp match="/^\-.*$/" region0="diffOrg"/>
   <regexp match="/^\+.*$/" region0="diffNew"/>
   <regexp match="/^\@\@.*\@\@$/" region0="diffModif"/>

   <!-- 'normal' mode -->
   <regexp match="/^d\d+\s\d+$/" region0="diffOrg"/>
   <regexp match="/^a\d+\s\d+$/" region0="diffNew"/>

   <!-- ed mode -->
   <block start="/^(\d+)(a)$/" end="/^(\.)$/" scheme="Comment"
          region="diffNew" region01="diffNumb" region02="diffModif" region10="diffModif"/>
   <block start="/^(\d+)(d)$/" end="/^(\.)$/" scheme="Comment"
          region="diffOrg" region01="diffNumb" region02="diffModif" region10="diffModif"/>
   <block start="/^(\d+)(c)$/" end="/^(\.)$/" scheme="Comment"
          region="diffChanged" region01="diffNumb" region02="diffModif" region10="diffModif"/>

   <!-- Numbers -->
   <regexp match="/\b0x|X[\da-fA-F]+\B/" region0="diffNumb"/>
   <regexp match="/\d+/" region0="diffNumb"/>
</scheme>

</hrc>