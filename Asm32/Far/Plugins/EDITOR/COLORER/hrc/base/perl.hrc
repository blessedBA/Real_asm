<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    Perl Syntax Description
With help of:
    alexander smishlajev <als@turnhere.com>
    JULY <lubimovi@usa.net>
    Timur Safin <timur@lanit.ru>
    cail: now using different schemes for
          different paired limiters, fulll s()() support
          needs complex variables parsing - using refs, hashs and lists
          also to correct constructions as    s@  foo  @  @bar  @ix;
-->
<hrc>

<define name="plString"   value="dString"/>
<define name="plStringQuote" value="dStringQuote"/>
<define name="plComment"  value="dComment"/>
<define name="plSymb"     value="dSymbol"/>
<define name="plMainSymb" value="dSymbol2"/>
<define name="plWord"     value="dKeyword"/>
<define name="plNumb"     value="dNumber"/>

<define name="plStream"   value="dPath"/>
<define name="plRare"     value="dComment2"/>

<define name="plSlash"    value="dString2"/>
<define name="plVar"      value="dVar"/>
<define name="plVar2"     value="dVar2"/>

<define name="plPod"      value="dPod"/>
<define name="plPodSym"   value="dSymbol"/>
<define name="plPodText"  value="default"/>
<define name="plPodSel"   value="dString"/>

<scheme name="perlVars">
   <regexp match="/\$\#?[\w][\w_']*((::)[\w_']*?)?\B/" region0="plVar" region2="plSymb"/>
   <!-- cail: hacks $lala%124 (mod operator)-->
   <regexp match="/[\@\%][a-zA-Z_]([\w_']*?[a-zA-Z_][\w_']*?)?\B/" region0="plVar"/>
   <regexp match="/\*[^\W\d][\w_']*\B/" region0="plVar"/>
   <regexp match="/\$ [^{}\(\)] \w? \M \W|$/x" region0="plVar"/>
   <regexp match="/\* [^\w\s\{\[\$\@\%\(]/x" region0="plVar"/>
</scheme>

<scheme name="perlVarsEx">
   <!-- interpolating. note, that perl5 iterpolates only $ and @ -->
   <regexp match="/\$\#?[\w][\w_':]*?\B/ix"
           region0="plVar2" region2="plSymb" lowpriority="lowpriority"/>
   <regexp match="/\@[a-zA-Z_]([\w_']*?[a-zA-Z_][\w_']*?)?\B/ix"
           region0="plVar2" lowpriority="lowpriority"/>
   <!-- cail: often conflicts in s///
   <regexp match="/\$ [^{}\(\)\/] \w? \M \W|$/x" region0="plVar2"/-->

   <!--?whats this??  regexp match="/([\$\@][\$\@\%]*[\w]([\w_']|(::))*)\B/" region1="plVar2" region3="plVar2"/>
   <regexp match="/([\$\@][\$\@\%]*\{[^\}]+\})/" region0="plVar2"/-->
</scheme>

<scheme name="perlPod">
   <inherit scheme="mNetAddresses"/>
   <regexp match="/^=(pod)|(cut)/" region0="plPodSym"/>
   <regexp match="/^=head[12]\s(.*)$/" region0="plPodSym" region1="plPodText"/>
   <regexp match="/^=(item)|(back)|(end)/" region0="plPodSym"/>
   <regexp match="/^=over\s+(\d+)/" region0="plPodSym" region1="plNumb"/>
   <regexp match="/[IBSCLFXZE]&lt;.*?>/" region0="plPodSel"/>
</scheme>

<scheme name="perlMETA">
</scheme>

<scheme name="perlString">
   <inherit scheme="perlMETA"/>
   <!-- Non-interpolated string ignore all escape-sequences except \' and \\ -->
   <regexp match="/\\['\\\/]/" region0="plSlash"/>
</scheme>

<scheme name="perlInterpolatedString">
   <inherit scheme="perlMETA"/>
   <inherit scheme="mNetAddresses"/>
   <regexp  match="/\b0x|X[\da-fA-F]+\B/" region0="plNumb"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="mDecNumb"/>
   <!-- cail: problems with s@ foo @ bar @ix;
              @ix is not a list :(( -->
   <inherit scheme="perlVarsEx"/>
   <regexp match='/\\x|X[\da-fA-F]{1,2}/' region0="plSlash"/>
   <regexp match='/\\[0-7]{1,3}/' region0="plSlash"/>
   <regexp match='/\\[^xX0-7]/' region0="plSlash"/>
</scheme>

<!-- schemes with braces for noninterpolated q
    cail: some notes about support all quoted strings and regexps
          if you using paired characters - ()[]{}<>
          perl parses string in two phases - first it
          searches end of string - and counts and support all enclosed
          pairs in string - and next, it works with target strings
          with their real meaning (at first phase it doesn't interested in
          target string predestination...
          so, all codes follows here these rules
-->
<scheme name="perlStrBr1">
   <regexp match="/\\[\(\)]/" region0="plSlash"/>
   <block scheme="perlStrBr1" start="/\(/" end="/\)/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>
<scheme name="perlStrBr2">
   <regexp match="/\\[\{\}]/" region0="plSlash"/>
   <block scheme="perlStrBr2" start="/\{/" end="/\}/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>
<scheme name="perlStrBr3">
   <regexp match="/(\\[\[\]])/" region0="plSlash"/>
   <block scheme="perlStrBr3" start="/\[/" end="/\]/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>
<scheme name="perlStrBr4">
   <regexp match="/(\\[&lt;\>])/" region0="plSlash"/>
   <block scheme="perlStrBr3" start="/&lt;/" end="/\>/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>


<!-- schemes with braces for interpolated qq qw s tr ... -->
<scheme name="perlSubstComment">
   <!-- are we need here  lowpriority="lowpriority" ??? -->
   <regexp match="/(^\s*)|(\s{2,})(\#.*$)/" region0="plComment"/>
</scheme>
<scheme name="perlSubstElements">
   <inherit scheme="perlInterpolatedString"/>
   <inherit scheme="perlSubstComment"/>
</scheme>

<scheme name="perlIntStrBr1">
   <inherit scheme="perlSubstElements"/>
   <block scheme="perlIntStrBr1" start="/\(/" end="/\)/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>
<scheme name="perlIntStrBr2">
   <inherit scheme="perlSubstElements"/>
   <block scheme="perlIntStrBr2" start="/\{/" end="/\}/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>
<scheme name="perlIntStrBr3">
   <inherit scheme="perlSubstElements"/>
   <block scheme="perlIntStrBr3" start="/\[/" end="/\]/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>
<scheme name="perlIntStrBr4">
   <inherit scheme="perlSubstElements"/>
   <block scheme="perlIntStrBr3" start="/&lt;/" end="/\>/"
          region00="dpOpenStruct" region10="dpCloseStruct"/>
</scheme>


<!-- schemes to support
     s(
       foo
     ) (
       bar
     )igx
-->
<scheme name="perlSubstMiddle1">
   <block start="/~ s|(tr)|y \s* \( /x" end="/\)/x"
          scheme="perlIntStrBr1" region10="plStringQuote"/>
   <inherit scheme="perlSubstComment"/>
   <regexp match="/\S+?/" region0="dError" lowpriority="lowpriority"/>
</scheme>
<scheme name="perlSubstBlock1">
   <block start="/~ \M s|(tr)|y \s* \( /x" end="/\(/x"
          scheme="perlSubstMiddle1" region10="plStringQuote"/>
   <inherit scheme="perlIntStrBr1"/>
</scheme>

<scheme name="perlSubstMiddle2">
   <block start="/~ s|(tr)|y \s* \{ /x" end="/\}/x"
          scheme="perlIntStrBr2" region10="plStringQuote"/>
   <inherit scheme="perlSubstComment"/>
   <regexp match="/\S+/" region0="dError" lowpriority="lowpriority"/>
</scheme>
<scheme name="perlSubstBlock2">
   <block start="/~ \M s|(tr)|y \s* \{ /x" end="/\{/x"
          scheme="perlSubstMiddle2" region10="plStringQuote"/>
   <inherit scheme="perlIntStrBr2"/>
</scheme>

<scheme name="perlSubstMiddle3">
   <block start="/~ s|(tr)|y \s* \[ /x" end="/\]/x"
          scheme="perlIntStrBr3" region10="plStringQuote"/>
   <inherit scheme="perlSubstComment"/>
   <regexp match="/\S+/" region0="dError" lowpriority="lowpriority"/>
</scheme>
<scheme name="perlSubstBlock3">
   <block start="/~ \M s|(tr)|y \s* \[ /x" end="/\[/x"
          scheme="perlSubstMiddle3" region10="plStringQuote"/>
   <inherit scheme="perlIntStrBr3"/>
</scheme>

<scheme name="perlSubstMiddle4">
   <block start="/~ s|(tr)|y \s* &lt; /x" end="/\>/x"
          scheme="perlIntStrBr4" region10="plStringQuote"/>
   <inherit scheme="perlSubstComment"/>
   <regexp match="/\S+/" region0="dError" lowpriority="lowpriority"/>
</scheme>
<scheme name="perlSubstBlock4">
   <block start="/~ \M s|(tr)|y \s* &lt; /x" end="/&lt;/x"
          scheme="perlSubstMiddle4" region10="plStringQuote"/>
   <inherit scheme="perlIntStrBr4"/>
</scheme>

<scheme name="perlSubstBlock">
   <block start="/~ s|(tr)|y ([^\w\s]) /x" end="/\y2/x"
          scheme="perlSubstElements" region10="plStringQuote"/>
   <inherit scheme="perlSubstElements"/>
</scheme>

<scheme name="perl">
   <!-- linear comments -->
   <block start="/;?\#/" end="/$/" region="plComment" scheme="Comment"/>
   <!-- Variables -->
   <inherit scheme="perlVars"/>
   <regexp match="/((sub)|(package)) ([\w_']+)/" region0="plWord" region4="dFunction"/>

   <!-- perl 5.6.0 number-encoded strings -->
   <regexp match="/\bv(\d+)(\.\d+)*\B/" region0="plString"/>
   <regexp match="/\b(\d+)(\.\d+){2,}\B/" region0="plString"/>

   <!-- perl numbers  -->
   <regexp match="/\b0x|X[\da-fA-F_]+/" region0="plNumb"/>
   <regexp match="/\b\d[\d_]*\./" region0="plNumb"/>
   <regexp match="/\c[\d_]*\.?\d[\d_]*(e|E[\-+]?[\d_]+)?/" region0="plNumb"/>
   <regexp match="/\b\d[\d_]+/" region0="plNumb"/>

   <!-- strings -->
   <block start='/`/' end='/`/' scheme="perlInterpolatedString"
          region="plString" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start='/"/' end='/"/' scheme="perlInterpolatedString"
          region="plString" region00="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/'/" end="/'/" scheme="perlString"
          region="plString" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <!-- cail: paired block for matching -->
   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="perl"/>
   </inherit>

   <!-- cail: this block cracks the constructions
     $var = $var / $var / $var;
     $var =~ / $var /;
     if (/ $var /){};
     and so on...

     can't use ?regexp? - it conflicts with  $a = $b ? 1 : 2;
     really ?this? is deprecated construction in perl5, so...
   -->
   <block start="/((\=|\! \~) |
                  [^&lt;\]\}\)\+\-\w\s\/] |
                  (\bif) | (\bunless) | (\bsplit) | ~ | ^ )
                 \s*
                 ((\/))
                /x"
          end="/(\y6[cmiogxes]* )/x" scheme="perlInterpolatedString"
          region="plString" region01="plSymb"
          region06="plStringQuote" region07="dpOpenStruct"
          region10="plStringQuote" region11="dpCloseStruct"/>

   <!-- formatted output -->
   <block start="/\bformat \s+ (\w+?) \s* =/x" end="/^\./" scheme="perlInterpolatedString"
          region="plString" region00="plWord"
          region01="dpOpenStruct" region10="dpCloseStruct"/>
   <block start="/&lt;&lt;\x22([a-zA-Z_][\w_]+?)\x22/" end="/^(\y1)$/" scheme="perlInterpolatedString"
          region="plString" region00="dpOpenStruct" region10="dpCloseStruct"
          region01="plWord" region11="plWord"/>
   <block start="/&lt;&lt;'([a-zA-Z_][\w_]+?)'/" end="/^(\y1)$/" scheme="Comment"
          region="plString" region00="dpOpenStruct" region10="dpCloseStruct"
          region01="plWord" region11="plWord"/>
   <block start="/&lt;&lt;([a-zA-Z_][\w_]+)/" end="/^(\y1)$/" scheme="perlInterpolatedString"
          region="plString" region00="dpOpenStruct" region10="dpCloseStruct"
          region01="plWord" region11="plWord"/>
   <!-- cail: perl in perl :)
   <block start="/(eval)\s+<<'([^']+)'/i" end="/^(\y2)$/" scheme="Perl" region1="dInserts" region2="plWord" region3="plWord" region4="plWord"-->
   <!-- pod stuff -->
   <block start="/\M^=/" end="/^=(head)|(cut)\m/" scheme="perlPod" region="plPod" region10="plPodSym"/>
   <block start="/__(END)|(DATA)__/" end="/$lalala^/" scheme="perlPod" region="plPod"/>

   <!-- streams and globs with html </script> hack -->
   <regexp match="/&lt;(\/script)?![^\s]*?\>/i" region0="plStream"/>

   <regexp match="/\c \- [ABCMORSTWXbcdefgkloprstuwxz]\B/x" region0="plWord"/>
   <regexp match="/x(\d+)/x" region0="plWord" region1="plNumb"/>

   <!-- base syntax -->
   <keywords region="plWord">
     <word name="sub"/>    <word name="do"/>   <word name="return"/>
     <word name="while"/>  <word name="until"/><word name="unless"/>
     <word name="if"/>     <word name="else"/> <word name="elsif"/>
     <word name="foreach"/><word name="for"/>  <word name="continue"/>
     <word name="next"/>   <word name="last"/> <word name="redo"/>
     <word name="goto"     region="plRare"/>
     <word name="__DATA__" region="plRare"/>
     <word name="__END__"  region="plRare"/>
     <word name="__FILE__" region="plRare"/>
     <word name="__LINE__" region="plRare"/>
     <word name="no"/><word name="use"/>
     <word name="require"/><word name="package"/>
     <word name="strict"/><word name="local"/><word name="my"/>
   <!-- functions -->
     <word name="AUTOLOAD"/>
     <word name="BEGIN"/>
     <word name="CORE"/>
     <word name="DESTROY"/>
     <word name="END"/>
     <word name="SUPER"/>
     <word name="UNIVERSAL"/>
     <word name="accept"/>
     <word name="alarm"/>
     <word name="atan2"/>
     <word name="bind"/>
     <word name="binmode"/>
     <word name="bless"/>
     <word name="caller"/>
     <word name="chdir"/>
     <word name="chmod"/>
     <word name="chomp"/>
     <word name="chop"/>
     <word name="chown"/>
     <word name="chr"/>
     <word name="chroot"/>
     <word name="close"/>
     <word name="closedir"/>
     <word name="connect"/>
     <word name="cos"/>
     <word name="crypt"/>
     <word name="dbmclose"/>
     <word name="dbmopen"/>
     <word name="defined"/>
     <word name="delete"/>
     <word name="die"/>
     <word name="dump"/>
     <word name="each"/>
     <word name="endgrent"/>
     <word name="endhostent"/>
     <word name="endnetent"/>
     <word name="endprotoent"/>
     <word name="endpwent"/>
     <word name="endservent"/>
     <word name="eof"/>
     <word name="eval"/>
     <word name="exec"/>
     <word name="exit"/>
     <word name="exp"/>
     <word name="fcntl"/>
     <word name="fileno"/>
     <word name="flock"/>
     <word name="fork"/>
     <word name="formline"/>
     <word name="getc"/>
     <word name="getgrent"/>
     <word name="getgrgid"/>
     <word name="getgrname"/>
     <word name="gethostbyaddr"/>
     <word name="gethostbyname"/>
     <word name="gethostent"/>
     <word name="getlogin"/>
     <word name="getnetbyaddr"/>
     <word name="getnetbyname"/>
     <word name="getnetent"/>
     <word name="getpeername"/>
     <word name="getpgrp"/>
     <word name="getppid"/>
     <word name="getpriority"/>
     <word name="getprotobyname"/>
     <word name="getprotobynumber"/>
     <word name="getprotoent"/>
     <word name="getpwent"/>
     <word name="getpwnam"/>
     <word name="getpwuid"/>
     <word name="getservbyname"/>
     <word name="getservbyport"/>
     <word name="getservent"/>
     <word name="getsockname"/>
     <word name="getsockopt"/>
     <word name="glob"/>
     <word name="gmtime"/>
     <word name="grep"/>
     <word name="hex"/>
     <word name="index"/>
     <word name="int"/>
     <word name="ioctl"/>
     <word name="join"/>
     <word name="keys"/>
     <word name="kill"/>
     <word name="lc"/>
     <word name="lcfirst"/>
     <word name="length"/>
     <word name="link"/>
     <word name="listen"/>
     <word name="localtime"/>
     <word name="log"/>
     <word name="lstat"/>
     <word name="map"/>
     <word name="mkdir"/>
     <word name="msgctl"/>
     <word name="msgget"/>
     <word name="msgrcv"/>
     <word name="msgsnd"/>
     <word name="oct"/>
     <word name="open"/>
     <word name="opendir"/>
     <word name="ord"/>
     <word name="pack"/>
     <word name="pipe"/>
     <word name="pop"/>
     <word name="pos"/>
     <word name="print"/>
     <word name="printf"/>
     <word name="push"/>
     <word name="quotemeta"/>
     <word name="rand"/>
     <word name="read"/>
     <word name="readdir"/>
     <word name="readline"/>
     <word name="readlink"/>
     <word name="recv"/>
     <word name="ref"/>
     <word name="rename"/>
     <word name="reset"/>
     <word name="reverse"/>
     <word name="rewindir"/>
     <word name="rindex"/>
     <word name="rmdir"/>
     <word name="scalar"/>
     <word name="seek"/>
     <word name="seekdir"/>
     <word name="select"/>
     <word name="semctl"/>
     <word name="semgett"/>
     <word name="semop"/>
     <word name="send"/>
     <word name="setgrent"/>
     <word name="sethostent"/>
     <word name="setnetent"/>
     <word name="setpgrp"/>
     <word name="setpriority"/>
     <word name="setprotoent"/>
     <word name="setpwent"/>
     <word name="setservent"/>
     <word name="setsockopt"/>
     <word name="shift"/>
     <word name="shmctl"/>
     <word name="shmget"/>
     <word name="shmread"/>
     <word name="shmwrite"/>
     <word name="shutdown"/>
     <word name="sin"/>
     <word name="sleep"/>
     <word name="socket"/>
     <word name="socketpair"/>
     <word name="sort"/>
     <word name="splice"/>
     <word name="split"/>
     <word name="sprintf"/>
     <word name="sqrt"/>
     <word name="srand"/>
     <word name="stat"/>
     <word name="study"/>
     <word name="substr"/>
     <word name="symlink"/>
     <word name="syscall"/>
     <word name="sysopen"/>
     <word name="sysread"/>
     <word name="system"/>
     <word name="syswrite"/>
     <word name="tell"/>
     <word name="telldir"/>
     <word name="tie"/>
     <word name="tied"/>
     <word name="time"/>
     <word name="times"/>
     <word name="truncate"/>
     <word name="uc"/>
     <word name="ucfirst"/>
     <word name="umask"/>
     <word name="undef"/>
     <word name="unlink"/>
     <word name="unpack"/>
     <word name="unshift"/>
     <word name="utime"/>
     <word name="values"/>
     <word name="vec"/>
     <word name="wait"/>
     <word name="waitpid"/>
     <word name="wantarray"/>
     <word name="warn"/>
     <word name="write"/>
     <word name="x"/>
   </keywords>
   <!-- cail: regexps
        in reallity  s'foo'bar' does no interpolation - but i thing this
          isn't so important :)
        currently this subst will not work in such cases:
         s        # here we can't know which of schemes was called :(
         {        #
          foo
         }        # but such form is works :)
         {        #
          bar
         }ix;
        but i think this is real perversion :)
   -->
   <block start="/\b\M((s|(tr)|y \s* \())/x" end="/(\) [mgeioxs]*)/x"
          scheme="perlSubstBlock1" region="plString"
          region01="dpOpenStruct" region10="dpCloseStruct"
          region02="plStringQuote" region11="plStringQuote"/>
   <block start="/\b\M((s|(tr)|y \s* \{))/x" end="/(\} [mgeioxs]*)/x"
          scheme="perlSubstBlock2" region="plString"
          region01="dpOpenStruct" region10="dpCloseStruct"
          region02="plStringQuote" region11="plStringQuote"/>
   <block start="/\b\M((s|(tr)|y \s* \[))/x" end="/(\] [mgeioxs]*)/x"
          scheme="perlSubstBlock3" region="plString"
          region01="dpOpenStruct" region10="dpCloseStruct"
          region02="plStringQuote" region11="plStringQuote"/>
   <block start="/\b\M((s|(tr)|y \s* &lt;))/x" end="/(\> [mgeioxs]*)/x"
          scheme="perlSubstBlock4" region="plString"
          region01="dpOpenStruct" region10="dpCloseStruct"
          region02="plStringQuote" region11="plStringQuote"/>
   <block start="/\b\M((s|(tr)|y \s* ([^\w\s])))/x" end="/(\y4 [mgeioxs]*)/x"
          scheme="perlSubstBlock" region="plString"
          region01="dpOpenStruct" region10="dpCloseStruct"
          region02="plStringQuote" region11="plStringQuote"/>

   <!-- Timur: see `perldoc perlop`
       "Quote and Quote-like Operators " -->
   <block start="/\b(q[qxr]\s*\()/" end="/(\))/" region="plString" scheme="perlIntStrBr1"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q[qxr]\s*\{)/" end="/(\})/" region="plString" scheme="perlIntStrBr2"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q[qxr]\s*\[)/" end="/(\])/" region="plString" scheme="perlIntStrBr3"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q[qxr]\s*&lt;)/" end="/(\>)/" region="plString" scheme="perlIntStrBr4"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q[qxr]\s*([^\w\s]))/" end="/(\y2)/" region="plString" scheme="perlInterpolatedString"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>

   <block start="/\b(q(w)?\s*\()/" end="/(\))/" region="plString" scheme="perlStrBr1"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q(w)?\s*\{)/" end="/(\})/" region="plString" scheme="perlStrBr2"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q(w)?\s*\[)/" end="/(\])/" region="plString" scheme="perlStrBr3"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q(w)?\s*&lt;)/" end="/(\>)/" region="plString" scheme="perlStrBr4"
          region00="plStringQuote"  region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(q(w)?\s*([^\w\s]))/" end="/(\y3)/" region="plString" scheme="perlString"
          region00="plStringQuote" region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>

   <block start="/\b(m \s* \()/x" end="/(\)[cmiogxs]*)/" scheme="perlIntStrBr1"
          region="plString" region00="plStringQuote" region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(m \s* \{)/x" end="/(\}[cmiogxs]*)/" scheme="perlIntStrBr2"
          region="plString" region00="plStringQuote" region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(m \s* \[)/x" end="/(\][cmiogxs]*)/" scheme="perlIntStrBr3"
          region="plString" region00="plStringQuote" region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(m \s* &lt;)/x" end="/(\>[cmiogxs]*)/" scheme="perlIntStrBr4"
          region="plString" region00="plStringQuote" region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <block start="/\b(m \s* ([^\s\w]))/x" end="/(\y2[cmiogxs]*)/" scheme="perlInterpolatedString"
          region="plString" region00="plStringQuote" region10="plStringQuote"
          region01="dpOpenStruct" region11="dpCloseStruct"/>
   <!-- Timur: hack against Ada maniacs -->
   <regexp match="/\c&amp;|(\w+)'[\w_']+\B/" region0="plVar"/>

   <!-- operators -->
   <keywords region="plSymb">
     <symb name="!"/><symb name="~"/><symb name="\"/>
     <symb name="+"/><symb name="-"/><symb name="."/>
     <symb name="*"/><symb name="/"/>
     <symb name=".."/><symb name="%"/>
     <word name="lt"/><word name="gt"/>
     <word name="le"/><word name="ge"/>
     <word name="eq"/><word name="ne"/><word name="cmp"/>
     <symb name="&amp;"/><symb name="|"/><symb name="^"/>
     <symb name="?"/><symb name=":"/>
     <symb name=","/><symb name="="/>
     <word name="and"/><word name="not"/>
     <word name="or"/><word name="xor"/>
     <symb name="->"/><symb name="&gt;"/><symb name="&lt;"/>
     <symb name=";" region="PlMainSymb"/>
     <symb name="{" region="dError"/><symb name="}" region="dError"/>
     <symb name="(" region="dError"/><symb name=")" region="dError"/>
     <symb name="[" region="dError"/><symb name="]" region="dError"/>
   </keywords>
</scheme>

</hrc>
