<scheme name="mConfCommonRight">
   <!-- Linear Comments -->
   <block start="/^|(\s{1,})|(^\s+);/" end="/$/" scheme="Comment" region="dComment"/>
   <block start="/^|(\s{3,})|(^\s+)\/\//" end="/$/" scheme="Comment" region="dComment"/>
   <block start="/^|(\s{3,})|(^\s+)\#/" end="/$/" scheme="Comment" region="dComment"/>
   <regexp match="/^|(\s{3,})(&amp;&amp;.*$)/"  region2="dComment"/>
   <regexp match="/^|(\s{3,})(\*.*$)/" region2="dComment"/>
   <inherit scheme="mConfCore"/>
</scheme>

<scheme name="mConfCommon">
   <inherit scheme="mConfCommonRight"/>
   <inherit scheme="mConfKeywords"/>
</scheme>

<scheme name="mConfStrings">
    <!-- Strings -->
    <block start="/'/" end="/'|$/" scheme="ConfString" region="dString"/>
    <block start='/"/' end='/"|$/' scheme="ConfString" region="dString"/>
</scheme>

<scheme name="ConfString">
   <!--inherit scheme="mConfCore"-->
   <regexp match='/("")|(\\\\)|(\\")/' region0="dString2"/>
</scheme>

<scheme name="ConfRight">
    <inherit scheme="mConfStrings"/>
    <!-- Numbers -->
    <!--Timur: Hack justt for ignore 'pseudo' hex digits as "Add", "dbf" etc..-->
    <regexp match="/\b([A-Fa-f]+[^\d])?!(0x|X)?[\da-fA-F]+\B/" region0="dNumber"/>

    <inherit scheme="mConfCommonRight"/>

    <keywords ignorecase="ignorecase" region="dComment">
       <word name="DWord"/>
       <word name="Hex"/>
    </keywords>
</scheme>

<scheme name="Config">
    <inherit scheme="mConfCommon"/>
    <regexp match='/^\s*\[.*?\]/' region0="dComment2"/>
    <!-- Apache conf stuff -->
    <regexp match='/^\s*(&lt;.*?\>)\s*$/' region0="dComment2"/>
    <block  start="/(=)/" end="/^ | ([^\\]?#1) $/x" scheme="ConfRight" region00="dSymbol"/>
    <inherit scheme="mConfStrings"/>
</scheme>

</hrc>
