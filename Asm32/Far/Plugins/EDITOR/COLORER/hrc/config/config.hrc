<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!--
    Config Files
With help of:
    Vladimir Tarasov <tsoftgroup@chat.ru>
    Safin Timur <timur@lanit.ru>
    Alexander Polosow/Ђ«ҐЄб ­¤а Џ®«®§®ў 2:5025/54.32 aka 38.89
-->
<hrc>

<scheme name="mConfCore">
   <inherit scheme="mNetAddresses"/>
   <!-- Path -->
   <inherit scheme="mPath"/>
   <regexp match="/^\s* \M \[ .*? \]/x" region0="dFunction"/>
   <regexp match="/\%[\w\.]+\%/" region0="dVar"/>
   <regexp match="/\{[\da-fA-F]{8}\-[\da-fA-F]{4}\-[\da-fA-F]{4}\-[\da-fA-F]{4}\-[\da-fA-F]{12}\}/" region0="dNumber"/>
   <regexp match='/\-.*?\-/' region0="dString"/>
   <block start="/\{(\|.*?\|)/" end="/\}/" scheme="Config"
          region="dInsert" region01="dString2"/>
   <keywords ignorecase="ignorecase" region="dSymbol">
      <!--symb name="."-->
      <symb name=","/>
   </keywords>
</scheme>

<scheme name="mConfKeywords">
   <keywords ignorecase="ignorecase" region="dVar">
      <word name="ON"/><word name="OFF"/><word name="YES"/><word name="NO"/>
   </keywords>
   <!-- some popular fido and other keywords -->
