@RegExp
$^#Регулярные выражения - кто они?


#Операторы поиска/соответствия#

 #\ #
     цитирует следующий символ. Если следующий символ - не буква или цифра, он
потеряет свое специальное значение, иначе следующий символ будет
рассматриваться как описано ниже.
 #\n #
     Соответствует 0x0A (LF).
 #\r #
     Соответствует 0x0D (CR).
 #\t #
     Соответствует 0x09 (TAB).
 #\e #
     Соответствует ESCAPE (0x1B).
 #\s #
     Соответствует пробельному символу (CR, LF, TAB, SPACE).
 #\S #
     Соответствует непробельному символу (дополнение к \s) .
 #\w #
     Соответствует словарному символу [a-zA-Z0-9] .
 #\W #
     Соответствует несловарному символу.
 #\d #
     Соответствует цифре [0-9].
 #\D #
     Соответствует нецифровому символу.
 #\U #
     Соответствует символу в верхнем регистре (A-Z).
 #\L #
     Соответствует символу в нижнем регистре (a-z)
 #\x#### #
     Соответствует символу с HEX-кодом (\x0A, \x0D, \x09, etc.).
 #\o###### #
     Соответствует символу с OCT-кодом (\o000, \o015, etc.)
 #\N###### #
     Соответствует символу с DEC-кодом (\N000, \N013, \N009, etc.)
 #\C #
     Начинает регистро-зависимое соответствие.
 #\c #
     Начинает регистро-независимое соответствие.
 #^ #
     Соответствует началу строки.
 #$ #
     Соответствует концу строки.
 #. #
     Соответствует любому символу.
 #< #
     Соответствует началу слова (слово состоит из [A-Za-z0-9]).
 #> #
     Соответствует концу слова.
 #[ ] #
     Определяет набор символов ([abc123], [\]\x10], etc).
 #[ - ] #
     Определяет диапазоны символов ([0-9a-zA-Z_], [0-9], etc)
 #[^ ] #
     Определяет класс дополнения ([^a-z], [^\-], etc)
 #? #
     Matches preceeding pattern optionally (a?bc, filename\.?, $?, etc)
 #| #
     Matches preceeding or next pattern (a|b, c|d, abc|d). Only one character
will be used as pattern unless grouped together using {} or ().
 #* #
     Соответствует НУЛЕВОМУ или большему количеству символов из предыдущего оператора.
Соответствие "жадное" и набирает максимум символов.
 #+ #
     Соответствует ОДНОМУ или большему количеству символов из предыдущего оператора.
 Соответствие "жадное" и набирает максимум символов.
 #@@ #
     Match zero or more occurances of preceeding pattern. Matching is non-greedy
and will match as little as possible without causing the rest of the pattern match to fail.
 ### #
     Match one or more occurances of preceeding pattern. Matching is non-greedy.
 #{ } #
     Group patterns together to form complex pattern. ({abc}, {abc}|{cde}, {abc}?, {word}?)
 #( ) #
     Group patterns together to form complex pattern. Also used to save
the matched substring into the register which can be used for substitution
operation. Up to 9 registers can be used.

 #Операторы замены#

 #\ #
     Следующий символ теряет свой специальный смысл.
 #\n #
     Вставляет 0x0A (LF).
 #\r #
     Вставляет 0x0D (CR).
 #\t #
     Вставляет 0x09 (TAB).
 #\1 to \9 #
     Вставляет сохраненные подстроки (\1, \2, \3, to \9).
 #\0 #
     Вставляет старый абзац.
 #\u #
     Переводит следующий символ в верхний регистр.
 #\l #
     Переводит следующий символ в нижний регистр.
 #\U #
     Переводит все символы в верхний регистр до появления  \E или \e.
 #\L #
     Переводит все символы в нижний регистр до появления  \E или \e.

