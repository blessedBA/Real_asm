"Description"="wlx2far: Update QViewer"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Shell\CtrlShiftDown]
"Sequence"="Down F11 $If (CheckHotkey(\"G\")) G 3 $Else Esc $End"
"Description"="wlx2far: Update QViewer"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Shell\CtrlShiftLeft]
"Sequence"="Left F11 $If (CheckHotkey(\"G\")) G 3 $Else Esc $End"
"Description"="wlx2far: Update QViewer"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Shell\CtrlShiftRight]
"Sequence"="Right F11 $If (CheckHotkey(\"G\")) G 3 $Else Esc $End"
"Description"="wlx2far: Update QViewer"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Shell\CtrlShiftPgDn]
