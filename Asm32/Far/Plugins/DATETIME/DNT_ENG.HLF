@Format
$# Format specification#
^#Format#

 #%a %A #- Week day abbr / FULL
 #%b %B #- Month    abbr / FULL
 #%c    #- Data and Time
 #%d    #- Day 01-31
 #%H    #- Hour 00-23
 #%I    #- Hour 01-12
 #%j    #- day of year 001-356
 #%m    #- month num 01-12
 #%M    #- Minute 00-59
 #%p    #- AM / PM
 #%S    #- Seconds 00-59
 #%U    #- Week num (Sunday first) 00-53
 #%w    #- Weekday (Sunday first) 0-6
 #%W    #- Week num (Monday first) 00-53
 #%x    #- Data
 #%X    #- Time
 #%y %Y #- Year (without century 00-99) / (WITH CENTURY)

  ~Back~@Contents
@API
$#Dialog API#
  
   To use dialog API you must use
   Dialog.gen - dll with API
   Dialog.h   - C header with API defenition

   You may use DEF - file to link API at compilation.
   In that case use ##define DIALOG_LINK  before include.

  ~General functions~@General
  ~Get/Set functions~@GetSet
  ~Advanced functions~@AdvAPI
  ~Full list   ~@All
  ~Dialog file structure~@Structure
  ~Dialog using example~@Example
  ~RegExp and text parsing~@Misc

  ~Back~@Contents
@General
$# General functions#

 #int DialogInit(HANDLE hDll, struct  PluginStartupInfo Info )#
                 Dialog API initialization.
                 Must be use before any other Dialog API function.
                 #hDll  # - Handle plugin Dll.
                 #Info  # - FAR plugin API 
                  Return dialog handler (#Dialog#).
                 hDll may be NULL, but then for FAR 1.60
                 Dialog.gen have to be located in a system folder
                 ( Windows, WINNT, ...), or in folder included
                 in PATH variable, or in folder with Far.exe .
                 

 #DWORD LoadDialog(HMODULE hDll,char* File,char* DialogName)#
                 Dialog loading. 
                 #hDll      # - Handle plugin Dll.
                 #File      # - Dialog file name.
                 #DialogName# - Dialog name.
                 hDll may be NULL, but then you have tu use
                 full file name with path.

 #char* EnumDialog(HMODULE hDll,char* File,char* DialogName)#
                 Dialogs enumeration.
                 #hDll      # - Handle plugin Dll.
                 #File      # - Dialog file name.
                 #DialogName# - Dialog name.
                                If DialogName = "" (no NULL)
                                result is first dialog name.
                                Else result is next dialog name
                                after DialogName.
                                 Resulted name is copied to
                                DialogName and returned by
                                function.

                 hDll may be NULL, but then you have tu use
                 full file name with path.

 #int   ShowDialog(DWORD Dialog);#
                 Dialog show.
                 #Dialog    # - Dialog handler that was
                                returned by #LoadDialog#.

 #void  FreeDialog(DWORD Dialog);#
                 Dialog deletion.
                 #Dialog    # - Dialog handler.

  ~Dialog API~@API

@GetSet
$# Get/Set functions#
 
 #int   GetItemStatus(DWORD Dialog, int Id)#
                    Return dialog item status.

 #void  SetItemStatus(DWORD Dialog, int Id, int Value)#
                    Set dialog item status.

 #int   GetRadioStatus(DWORD Dialog, int Id)#
                    Return Id of dialog item of radio-group
                    that have status>0. Argument Id 
                    must be member of group.

 #void  SetRadioStatus(DWORD Dialog, int Id, int Id2)#
                    Id - member of this group.
                    Set in group with Id (Id - member of
                    group) Id2 dialog item to status = 1.


 #char *GetItemData(DWORD Dialog, int Id)#
                    Return pointer to Data field of
                    dialog item.

 #void  SetItemColor(DWORD Dialog, int Id, int Color)#
                    Set color for dialog item Id.

  ~Dialog API~@API

@AdvAPI
$# Advanced functions#

 #struct FarDialogItem * GetItemAddr(DWORD Dialog, int Id)#
                     Return pointer to dialog item record.

 #int   DialogGeneratorVersion(void)#
                     Return Dialog Generator version number.
                     F.e. 0x100  - for version 1.00 .

 #void  HideItem(DWORD Dialog, int Id)#
                     Hide dialog item (used last 5 byte of Data)

 #void  RestoreItem(DWORD Dialog, int Id)#
                     Restore hided dialog item.

 #void  *GetItemNULL(void)#
                     Return pointer to #DG_ITEM_NULL#
                     structure. It not need to be used.
                     It called on initialization.

  ~Dialog API~@API
