@Misc
$# Misc#

   Dialog API дополнительно экспортирует функцию #sparse# для парсинга
  текта. Конечно это не "регексп", но достаточно мощное средство,
  помогающее в большинстве случаев. На основе этой функции, например,
  производится разбор файлов с описаниями диалогов.

   Функция #sparse# разбирает входную строку сохраняя результат
  в промежуточном буфере.
   Функция #parseNum# принимает промежуточный буфер и возвращает
  количество элементов.
   Функция #parseGetStr# возвращает элемент из промежуточного
  буфера с заданным номером. Нумерация начинается от нуля.
   Функция #parseGet# - облегченный вариант предыдущей,
  возвращает элемент из промежуточного буфера с заданным номером.
  Нумерация начинается от нуля. Память под результат выделяется
  функцией, поэтому после использования результата высвободите
  память самостоятельно.

   Вот краткое описание этих функций.

  ~int sparse(char *source, char *format, char * dest, int len)~@sparse
  ~int parseNum(char *str)~@parseNum
  ~char *parseGetStr(char *str, char *dst, int num)~@parseGetStr
  ~char *parseGet(char *str, int num)~@parseGet

  ~Диалог API~@API
  ~В начало~@Contents

@parseGet
$# parseGet#

  #char *parseGet(char *str, int num)#
   #str# - буфер с результатом функции #sparse#.
   #num# - номер элемента (начиная с нуля).

  Возвращает указатель на строку с результатом. Память под
  результат выделяется при запросе. После использования
  нужно будет высвободить память самостоятельно.

  ~Диалог API~@API
  ~В начало~@Contents

@parseGetStr
$# parseGetStr#

  #char *parseGetStr(char *str, char *dst, int num)#
   #str# - буфер с результатом функции #sparse#.
   #dst# - буфер для результата.
   #num# - номер элемента (начиная с нуля).

  Возвращает указатель на буфер результата, в буфер копируется
  элемент с запрошенным номером.

  ~Диалог API~@API
  ~В начало~@Contents

@parseNum
$# parseNum#

  #int parseNum(char *str)#
   #str# - буфер с результатом функции #sparse#.
   Возврашает количество элементов в буфере.

  ~Диалог API~@API
  ~В начало~@Contents
@sparse
$# sparse#

  #int sparse(char *source, char *format, char * dest, int len)#
   #source# - строка для разбора
   #format# - формат разбора
   #dest  # - буфер для накопления результата
   #len   # - размер буфера
  Функция похожа по действию на #sscanf#. 
  Возвращает количество обработанных групп.
  Группа это спецификация формата или последоватнльность
  непробельных символов.

  #format# - состоит из пробелов, непробельных символов и
            спецификаций формата.
             Если встречается пробел - будут пропущены все
            последовательный пробелы (если есть) в source.
             Непробельный символ (кроме '%') - сравнивается
            со следующим символом из source, но не сохраняется.
            При неуспешном сравнении функция прерывается.
             Спецификация формата задает формат считываемого
            элемента и сохраняет его в буфере.
            Спецификации начинаются с '%' и меют вид:
            #% [+|*] [size] [case] type [~~default~~]#
            #[+|*] #  - #+# - "слить" считываемый элемент
                              со следующим
                      #*# - обработать без сохранения
            #[size]#  - максимальная длина элемента
            #[case]#  - обработка регистра символов
                        #l# - перед сравнением приводить
                              символы к нижнему регистру
                        #u# - приводить к верхнему
                        #n# - сравнивать без учета регистра
            #[~~default~~]# - при неуспешном чтении элемента
                          символы заключенные в ~~~~
                          сохраняются в буфере, после чего
                          сравнение считается успешным.
                          Например: #S:" asdfg" - F:" %d~~0~~"#
                          означает: считать число, если нет,
                          то результат #"0"#.
            #type#   - тип считываемого элемента.
                       #c#        - считать символ
                       #t#        - считать все символы до конца
                       #s#        - считать строку до пробела,
                                    \t или \n
                       #d#        - считать цифры
                       #[шаблон]# - считать символы, если входят
                                    во множество символов в
                                    шаблоне.
                                    Если первый символ шаблона
                                    #"^"# - то считываются
                                    символы не входящие в шаблон.
                       #{}#       - все символы между #{}#
                                    сохраняются в результате.
                       #[S][q](s1[-]s2)# - считать символы
                                    "закавыченые" между s1 и s2.
                                    Если указать #"-"# то чтение
                                    будет проводиться с учетом
                                    вложенности.
                                    #q# - сохранять так же и
                                          "кавычки"
                                    #S# - если нет "кавычек", то
                                          читать строку до пробела.
                                    Например:
                                      #S:" (a+(b-c))"-F:" %S((-))"#
                                    означает: считать элемент
                                    окруженный круглыми скобками
                                    с учетом вложенности, если нет,
                                    то считать строку до пробела.
                                    результат: "a+(b-c)".
                                    А если:
                                     #S:" a+(b -c))"-F:" %S((-))"#
                                    то результат: "a+(b".

   Пример:
  Формат разбора описания диалогов:
  #"%us %s %d %d %d %d %uc %Sq(\"\") %uS(()) %uc %u(%%)~~TXT~~ "#
  #"%u(%%)~~HKCU~~ %S(\"\")~~NULL~~ %S(\"\")~~NULL~~"#

   Вы можете использовать формат для задания регистра сравнения
  непробельных символов.
  Формат: #%{l|u|n}' '# - пробел после формата обязателен для
  отличия от спецификации формата.
  Пример: #S:" AsD" - F:" %l asd"#
  Результат: перед сравнением символы источника будут приводиться
           к младшему регистру. Соответственно сравнение успешно.

   Есть еще одна "псевдо" спецификация :#%[size]f#. Например: #%2f#.
  Ее функция - сбрасывать накопленный буфер при неуспешном сравнении.
  Обычно буфер сохраняется и содержит те элементы, которые были
  успешно обработаны, даже если обработка всех спецификаций на
  завершена. Но иногда нужно "все или ничего",т.е. либо обработка
  полностью завершена, либо буфер пустой. Для этого и предназначена
  #%[size]f#. Если размер не указан, то буфер сбрасывается при любом
  неуспешном сравнении. Размер задает границу, если число обработанных
  групп меньше указанного размера - буфер сбрасывается.

  ~Диалог API~@API
  ~В начало~@Contents
@Menu
$# General menu#
  Есть четыре основные команды:

  #Дата-и-Время (Авто)#      По этой команде Дата и Время в
                           заданном формате вставляется:
                            в редакторе   -    в текст, в текущее
                                               положение курсора
                            в файловой панели- в командную строку
                            не в редакторе-    в клипбоард.


  #Дата-и-Время (Меню)#      По этой команде Вы можете выбрать
                           нужный формат из меню, а так же
                           изменить или добавить новый.
                           В меню можно использовать:
                           Ins - для создания нового,
                           F4  - для редактирования,
                           Del - для удаления,
                           Enter, 0-9 - выбрать.

  #Дата-и-Время (Датчик)[&I]# По этой команде в верхнем правом углу
                           на короткое время
                           высвечивается текущая дата.

  #Календарь#                 По этой команде вызывается
                           календарь с текущим месяцем. Вы
                           можете сменить месяц, год просмотра, а
                           также вставить выбранную дату в 
                           редактируемый текст, коммандную строку
                           или клипбоард.
^#Меню#

  В меню Вы можете выбрать нужный формат или добавить новый.
  Редактировать:
   #Ins# - Создать новый формат.
   #F4 # - Редактирование формата.
   #Del# - Удаление.

  Выбрать:
   #Enter# - Выбрать текущий.
   #0-9  # - Выбрать формат с соответствующим номером.


  ~Диалог настройки формата~@MainDialog

  ~В начало~@Contents

@MainDialog
$# Основной диалог#


   ╔══════════  Дата-и-Время  ══════════╗
   ║ ( ) в редактор     [ ] без диалога ║
   ║ () в клипбоард                    ║
   ╟─Имя: ──────────────────────────────╢
   ║[Test 2                           ] ║
   ║ Формат:                            ║
   ║[%a %d dddhhhd                    ]║
   ╟────────────────────────────────────╢
   ║[  Да  ]  [ Сохранить ]  [ Отмена ] ║
   ╚════════════════════════════════════╝

                 
 #в редактор#    - если плагин открыт в редакторе то 
                 результат вставится в текущем положении
                 курсора, иначе в клипбоард.

 #в клипбоард#   - Поместить результат в клипбоард.

 #без диалога#   - Не показывать диалог.

 #Имя#           - Заголовок для формата.

 #Формат#        - Формат (команды описаны ниже).
                   Любые символы не совпадающие с
                   командами остаются без изменений.

 #Да#            - Выполнить заданные установки.
 #Сохранить#     - Сохранить текущие настройки.
 #Отмена#        - Отменить задание.


  ~В начало~@Contents

@Format
$# Format specification#
^#Формат#

 #%a %A #- День недели сокр. / ПОЛНЫЙ
 #%b %B #- Месяц сокр. / ПОЛНЫЙ
 #%c    #- Дата и Время ( 11/19/98 16:37:57 )
 #%d    #- День 01-31
 #%H    #- Час  00-23
 #%I    #- Час  01-12
 #%j    #- День года 001-356
 #%m    #- Номер месяца 01-12
 #%M    #- Минуты 00-59
 #%p    #- AM / PM
 #%S    #- Секунды 00-59
 #%U    #- Номер недели (Воскресенье первый день) 00-53
 #%w    #- День недели (Воскресенье первый день) 0-6
 #%W    #- Номер недели (Понедельник первый день) 00-53
 #%x    #- Дата
 #%X    #- Время
 #%y %Y #- Год (без века 00-99) / (С ВЕКОМ)

  ~В начало~@Contents
@API
$#Диалог API#
   Для использования Диалог API, Вам нужно 2 файла:
  Dialog.gen - dll с Диалог API
  Dialog.h   - хеадер с инициализацией API.
   Dialog.h состоит из двух частей:
    - для линковки при компиляции
    - для явной линковки во время выполнения

   Удобнее всего пользоваться вторым методом, кроме 
  того он более надежный. При этом разыскивается
  Dialog.gen сначала в директории с плагином, затем
  в директории с ФАР-ом и в системных каталогах.
  И еще, если какие-либо функции не инициализированы
  они заменяются стабом, что повышает надежность.

   Можно использовать DEF файл и подключить API
  к своему проекту на этапе компиляции. Для этого
  надо до include определить ##define DIALOG_LINK.

  ~Основные функции~@General
  ~Функции Get/Set~@GetSet
  ~Продвинутые :) функции~@AdvAPI
  ~Полный список   ~@All
  ~Структура файла диалогов~@Structure
  ~Пример использования диалога~@Example
  ~Регексп и парсинг текста~@Misc

  ~В начало~@Contents
@General
$# Основные функции#

 #int DialogInit(HANDLE hDll, struct  PluginStartupInfo Info )#
                 Инициализация Dialog API.
                 Должен вызываться до вызова любых
                 других фукций Dialog API.
                 #hDll  # - Хандлер Dll плагина
                 #Info  # - ФАР plugin API 
                 Возвращает описатель диалога (#Dialog#).
                 hDll может быть NULL, в этом случае для ФАР 1.60
                 Dialog.gen должен лежать в системной директории
                 ( Windows, WINNT, ...), либо упомянут в PATH,
                 либо в директории с Far.exe .
                 

 #DWORD LoadDialog(HMODULE hDll,char* File,char* DialogName)#
                 Загрузка диалога. 
                 #hDll      # - Хандлер Dll плагина
                 #File      # - Имя файла с описаниями диалогов
                 #DialogName# - Имя диалога
                 hDll может быть NULL, в этом случае должно
                 быть указано полное имя файла с путем.

 #char* EnumDialog(HMODULE hDll,char* File,char* DialogName)#
                 Перечисление диалогов. 
                 #hDll      # - Хандлер Dll плагина
                 #File      # - Имя файла с описаниями диалогов
                 #DialogName# - Имя диалога
                                Если имя "" (но не NULL), то
                                будет найден первый диалог,
                                иначе следующий диалог после
                                заданного.
                                Результат копируется в DialogName
                                и возвращается функцией.

                 hDll может быть NULL, в этом случае должно
                 быть указано полное имя файла с путем.

 #int   ShowDialog(DWORD Dialog);#
                 Активизация диалога.
                 #Dialog    # - Описатель диалога
                                возвращаемый функцией
                                #LoadDialog#.

 #void  FreeDialog(DWORD Dialog);#
                 Удаление диалога.
                 #Dialog    # - Описатель диалога.

  ~Диалог API~@API

@GetSet
$# Функции Get/Set#
 
 #int   GetItemStatus(DWORD Dialog, int Id)#
                    Возвращает Status элемента диалога.

 #void  SetItemStatus(DWORD Dialog, int Id, int Value)#
                    Устанавливает Status элемента диалога.

 #int   GetRadioStatus(DWORD Dialog, int Id)#

                    Возвращает Id элемента принадлежащего
                    группе RadioButton-ов или Button-ов
                    со ненулевым значением Status.
                    Группа идентифицируется по параметру
                    Id - должен принадлежать этой группе.

 #void  SetRadioStatus(DWORD Dialog, int Id1, int Id2)#
                    Устанавливает в группе RadioButton-ов
                    или Button-ов статус для элемента Id2.
                    Группа идентифицируется по аргументу
                    Id - должен принадлежать этой группе.

 #char *GetItemData(DWORD Dialog, int Id)#
                    Возвращает указатель на поле Data
                    элемента Id диалога.

 #void  SetItemColor(DWORD Dialog, int Id, int Color)#
                    Устанавливает цвет элемента Id.

  ~Диалог API~@API

@AdvAPI
$# Продвинутые :) функции#

 #struct FarDialogItem * GetItemAddr(DWORD Dialog, int Id)#
                     Возвращает указатель на элемент диалога.
                     Это если есть необходимость что-то
                     сделать напрямую с элементом диалога.

 #int   DialogGeneratorVersion(void)#
                     Возвращает номер версии ДиалогГенератора.
                     Например 0x100 - версия 1.00 .

 #void  HideItem(DWORD Dialog, int Id)#
                     Скрывает элемент Id из диалога.
                     При этом портятся последние 5 байт
                     из массивы Data.

 #void  RestoreItem(DWORD Dialog, int Id)#
                     Восстанавливает предварительно
                     скрытый элемент диалога.

 #void  *GetItemNULL(void)#
                     В целях повышения устойчивости 
                     вместо значения NULL используется
                     #DG_ITEM_NULL#. По сути это указатель
                     на FarDialogItem. Специально функцию
                     вызывать нет необходимости,
                     DG_ITEM_NULL объявляется при 
                     инициализации генератора.

  ~Диалог API~@API
  ~В начало~@Contents
