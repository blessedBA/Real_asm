@Structure
$# Структура файла диалогов#
   Понимаю, что описание довольно поверхностное, но лучшим
  описанием будут рабочие примеры диалогов этого плагина.

  Файл состоит из описания констант и описания диалогов.
  Строка, начинающаяся с ';' считается комментарием.
  Описания констант приближены к формату языка C:

  #enum { [ _name_[=_value_],...] }#

  Описания Диалогов состоят из:
  #name " _name_of_dialog_ "#        - имя диалога
  #help " _name_of_help_contents_ "# - имя раздела помощи
                                     по умолчанию используется
                                     "Contents".

  Описание элементов:
  #name id x1 y1 x2 y2 focus selected Flags DefButton Data#
  где
   #name#         - тип элемента
   #id#           - Идентификатор - число или имя константы
   #x1 y1 x2 y2#  - координаты, ширина и высота
   #focus#        - F/T/0/1 - имеет ли элемент фокус ввода
   #selected#     - F/T/ номер или константа (.lng) / "строка"
                  номер и строка используются для задания
                  History строк ввода.
   #Flags#        - свойства элемента, цвет
   #DefButton#    - F/T/0/1 - только одна кнопка должна быть 
                  "по умолчанию"
   #Data#         - "Содержание" элемента.
                  Этот элемент может иметь ссылки на такие
                  источники как регестри, lng-файл.
                   Формат:
                  #%LNG% _имя константы_# - строка из lng-файла.
                  #[%TXT%] " _текст_ "#   - просто текст.
                  #%REG% [%HKCU% | %HKLM%] "_имя ключа_" по_умолчанию#
                       #по_умолчанию = [%DEF% "_значение_"]#
                       - данные из регестри. По умолчанию HKCU.
                         Если задано значение по умолчанию и данные
                         из регестри не удалось прочитать, то
                         будет использовано умолчание.
                         #"_имя ключа_"# - считается от ФАР-овского
                         ключа, т.е. от software\far\plugins\ .
                  #%VER%# - возвращает номер версии генератора.

   Типы элементов:

   #Types   {"TEXT","VTEXT","SINGLEBOX","DOUBLEBOX",#
            #"EDIT","PSWEDIT","FIXEDIT","BUTTON",#
            #"CHECKBOX","RADIOBUTTON"};#

   Флаги (свойства):

   #Flag    {"DIF_COLORMASK","DIF_SETCOLOR","DIF_BOXCOLOR",#
            #"DIF_GROUP","DIF_LEFTTEXT","DIF_MOVESELECT",#
            #"DIF_SHOWAMPERSAND","DIF_CENTERGROUP",#
            #"DIF_NOBRACKETS","DIF_SEPARATOR","DIF_EDITOR",#
            #"DIF_HISTORY"};#

   #Colors   {"BLACK","BLUE","GREEN","CYAN","RED","MAGENTA",#
             #"BROWN","LIGHTGRAY","DARKGRAY","LIGHTBLUE",#
             #"LIGHTGREEN","LIGHTCYAN","LIGHTRED",#
             #"LIGHTMAGENTA","YELLOW","WHITE"};#

   #BkColors  {"BK_BLACK","BK_BLUE","BK_GREEN","BK_CYAN","BK_RED",#
             #"BK_MAGENTA","BK_BROWN","BK_LIGHTGRAY","BK_DARKGRAY",#
             #"BK_LIGHTBLUE","BK_LIGHTGREEN","BK_LIGHTCYAN",#
             #"BK_LIGHTRED","BK_LIGHTMAGENTA","BK_YELLOW","BK_WHITE"};#


  ~Диалог API~@API
  ~В начало~@Contents
@Example
$# Пример#

  Использование диалога выбора цвета.
 Этот диалог специально был вынесен в отдельный файл,
 как в целях примера написания диалога, так и 
 потому что этот диалог, сам по себе, может быть
 полезен для других плагинов.

         ...
         #DialogInit(hndDll,Info);#
          // инициализация генератора, передаются хендл 
          // плагина и структура с FAR API.

         #dlg=LoadDialog(hndDll,"color.dlg","Color Select");#
          // загрузка диалога, передаются хендл
          // плагина, имя файла с диалогом, имя диалога

         #SetRadioStatus(dlg,1,col1);#
         #SetRadioStatus(dlg,16,col2);#
          // Устанавливаются текущие цвета.
          // Передаются описатель диалога,
          // Id элемента - члена группы
          // Id выбираемого элемента в группе.

         #do{#
             #SetItemColor(dlg,243,col1+col2);#
              // Установить цвет для "образца"
              // Передаются описатель диалога,
              // Id элемента - все элементы с
              // совпадающим Id изменят цвет.
              // Цвет.
             #res=ShowDialog(dlg);#
              // Активизировать диалог.
             #col1=GetRadioStatus(dlg,1);#
             #col2=GetRadioStatus(dlg,16);#
              // Получить выбранные цвета.
              // Передаются описатель и Id
           #}while(res!=242 && res!=-1);#
              // повторять пока диалог не принят
              // или отвергнуть.
              // 242 - Id кнопки "Да"
              // -1  - Id кнопки "Отменить" и
              // код возвращаемый при ESC.

         #if(res!=-1) color=col1+col2;#
              // Если диалог не был отвергнут
              // то применить новые цвета.
          ...

  ~Диалог API~@API
  ~В начало~@Contents
