; %a %A - Week day abbr / FULL
; %b %B - Month    abbr / FULL
; %c    - Date and Time
; %d    - Day 01-31
; %H    - Hour 00-23
; %I    - Hour 01-12
; %j    - day of year 001-356
; %m    - month num 01-12
; %M    - Minute 00-59
; %p    - AM / PM
; %S    - Seconds 00-59
; %U    - Week num (Sunday first) 00-53
; %w    - Weekday (Sunday first) 0-6
; %W    - Week num (Monday first) 00-53
; %x    - Date
; %X    - Time
; %y %Y - Year (without century 00-99) / (WITH CENTURY)

;Default date format
"%a %d %b %X %Y"
;Date indicator format
" %d.%m.%Y "
;Date indicator timeout (ms)
"1000"

