
enum { DnTmenu0,  DnTmenu1,  DnTmenu2,   DnTmenu3,   DnTmenu4, DnTtitle,
       DnTdialog, DnTformat, DnTind,    DnTtimeout, DnThistory, DnTedit,
       DnTpedit,  DnTborder, DnTinsert, DnTput,     DnTdlg,     DnTsep,
       DnTtit,    DnTok,     DnTsave,    DnTcancel,  DnTColBut,DnTTestBtn,
       DnTColor,  DnTForgr,  DnTBackgr,  DnTusedef,  DnTusedefF,DnTusrfrm,
       DnTpause,  DnTusetit, DnTusectrl, DnTsmode,
       DnTweekday,DnTweekend,DnTjan,     DnTfeb,     DnTmar,
       DnTapr,    DnTmay,    DnTjun,     DnTjul,     DnTaug,   DnTsen,
       DnToct,    DnTnov,    DnTdec,     DnTCalen,   DnTsetyear,DnTsetmon,
       DnTdlg2,   DnTsu,     DnTmo,	 DnTtu,	     DnTwe,	DnTth,
       DnTfr,	  DnTsa ,    DnTscript};

;enum { DnTmenu0,  DnTmenu1,  DnTmenu2,   DnTmenu3,   DnTtitle, DnTdialog,
