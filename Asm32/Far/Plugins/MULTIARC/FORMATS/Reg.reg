REGEDIT4

;Настройки для REG.FMT 1.1

[HKEY_CURRENT_USER\Software\Far\Plugins\MultiArc\Reg]

;Для всех параметров указаны их значения по умолчанию

;Выдавать предупреждение "Некорректный формат архива" для файлов с ошибками
"WarnErrors"=dword:00000001  

;Выдавать предупреждение "Ошибка чтения" если при чтении были обрезаны данные
"WarnOversizes"=dword:00000001

;Показывать параметры и ключи с ошибками в синтаксисе.
;(Показываются с атрибутом Hidden)
"ShowErrors"=dword:00000001

;Символ для замены прямого слэша - '▐'
"ForwardSlashSubst"=hex:de

;Символ для замены обратного слэша - '▌'
"BackSlashSubst"=hex:dd

;Символ, помечающий удаляемые ключи и параметры - '■'
"DeletionSign"=hex:fe
