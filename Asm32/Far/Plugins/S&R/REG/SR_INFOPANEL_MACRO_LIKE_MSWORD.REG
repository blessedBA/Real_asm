REGEDIT4
; Macros for replace with S&R standard search in the info panel (like MS Word)
; 'S' - hot key (use F4 in "Plugin commands" menu)

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\CtrlF]
"Sequence"="F11 S 1"
"Description"="SR: Search in Info"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\ShiftF4]
"Sequence"="F11 S 2"
"Description"="SR: Continue search"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\CtrlPgDn]
"Sequence"="F11 S 2"
"Description"="SR: Continue search"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\CtrlPgUp]
"Sequence"="F11 S 3"
"Description"="SR: Continue search (reverse search)"
"DisableOutput"=dword:00000001
