REGEDIT4
; Macros for search&replace in the editor (like MS Word)
; 'S' - hot key (use F4 in "Plugin commands" menu)

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlF]
"Sequence"="F11 S 1"
"Description"="SR: Search"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlH]
"Sequence"="F11 S 2"
"Description"="SR: Search and Replace"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\F3]
"Sequence"="F11 S 3"
"Description"="SR: Continue"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\ShiftF4]
"Sequence"="F11 S 3"
"Description"="SR: Continue"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlPgDn]
"Sequence"="F11 S 3"
"Description"="SR: Continue"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlPgUp]
"Sequence"="F11 S 4"
"Description"="SR: Continue (reverse search)"
"DisableOutput"=dword:00000001
