REGEDIT4
; Macros for replace with S&R standard search in the info panel
; 'S' - hot key (use F4 in "Plugin commands" menu)

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\F7]
"Sequence"="F11 s 1"
"DisableOutput"=dword:00000001
"Description"="SR: Search in Info"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\ShiftF7]
"Sequence"="F11 s 2"
"DisableOutput"=dword:00000001
"Description"="SR: Continue search"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\Space]
"Sequence"="F11 s 2"
"DisableOutput"=dword:00000001
"Description"="SR: Continue search"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Info\AltF7]
"Sequence"="F11 s 3"
"DisableOutput"=dword:00000001
"Description"="SR: Continue search (reverse search)"
