REGEDIT4
; Macros for search in the viewer (like MS Word)
; 'S' - hot key (use F4 in "Plugin commands" menu)

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Viewer\CtrlF]
"Sequence"="F11 S 1"
"Description"="SR: Search in Viewer"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\QView\F3]
"Sequence"="F11 S 2"
"Description"="SR: Continue search"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Viewer\ShiftF4]
"Sequence"="F11 S 2"
"Description"="SR: Continue search"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Viewer\CtrlPgDn]
"Sequence"="F11 S 2"
"Description"="SR: Continue search"
"DisableOutput"=dword:00000001

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Viewer\CtrlPgUp]
"Sequence"="F11 S 3"
"Description"="SR: Continue search (reverse search)"
"DisableOutput"=dword:00000001
