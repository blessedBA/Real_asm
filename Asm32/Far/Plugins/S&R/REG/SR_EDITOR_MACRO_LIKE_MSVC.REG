REGEDIT4
; Macros for search&replace in the editor (like MS VC)
; 'S' - hot key (use F4 in "Plugin commands" menu)

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlF]
"Sequence"="F11 s 1"
"DisableOutput"=dword:00000001
"Description"="SR: Search"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlF3]
"Sequence"="F11 s 5"
"DisableOutput"=dword:00000001
"Description"="SR: Search the word under the cursor"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlF7]
"Sequence"="F11 s 2"
"DisableOutput"=dword:00000001
"Description"="SR: Search and Replace"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\CtrlShiftF3]
"Sequence"="F11 s 6"
"DisableOutput"=dword:00000001
"Description"="SR: Reverse search the word under the cursor"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\F7]
"Sequence"="F11 s 3"
"DisableOutput"=dword:00000001
"Description"="SR: Continue"

[HKEY_CURRENT_USER\Software\Far\KeyMacros\Editor\ShiftF7]
"Sequence"="F11 s 4"
"DisableOutput"=dword:00000001
"Description"="SR: Continue"
